diff --git a/drivers/cpuidle/cpuidle.c b/drivers/cpuidle/cpuidle.c
--- a/drivers/cpuidle/cpuidle.c
+++ b/drivers/cpuidle/cpuidle.c
@@ -187,7 +187,10 @@
  * @latency_limit_ns: Idle state exit latency limit
  *
  * If there are states with the ->enter_s2idle callback, find the deepest of
- * them and enter it with frozen tick.
+ * them and enter it with frozen tick. State zero may be used only if the
+ * driver explicitly provides an s2idle callback for it.
+ *
+ * Return: entered state index (including zero), or a negative error.
  */
 int cpuidle_enter_s2idle(struct cpuidle_driver *drv, struct cpuidle_device *dev,
 			 u64 latency_limit_ns)
@@ -199,12 +202,15 @@
 	 * specified latency limit, which guarantees that interrupts won't be
 	 * enabled when it exits and allows the tick to be frozen safely.
 	 */
-	index = find_deepest_state(drv, dev, latency_limit_ns, 0, true);
-	if (index > 0) {
-		enter_s2idle_proper(drv, dev, index);
-		local_irq_enable();
-	}
-	return index;
+	index = find_deepest_state(drv, dev, latency_limit_ns, 0, true);
+	if (!index && (!drv->states[0].enter_s2idle ||
+		       dev->states_usage[0].disable ||
+		       drv->states[0].exit_latency_ns > latency_limit_ns))
+		return -ENODEV;
+
+	enter_s2idle_proper(drv, dev, index);
+	local_irq_enable();
+	return index;
 }
 #endif /* CONFIG_SUSPEND */
 

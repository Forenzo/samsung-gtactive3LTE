+module_param_named(s2idle_wfi, psci_s2idle_wfi, bool, 0444);
+MODULE_PARM_DESC(s2idle_wfi, "Allow architectural WFI as an s2idle fallback");
 
 void psci_set_domain_state(struct generic_pm_domain *pd, unsigned int state_idx,
 			   u32 state)
@@ -223,7 +228,15 @@
 	return CPU_PM_CPU_IDLE_ENTER_PARAM_RCU(psci_cpu_suspend_enter, idx, state[idx]);
 }
 
-static const struct of_device_id psci_idle_state_match[] = {
+static __cpuidle int psci_enter_wfi_s2idle(struct cpuidle_device *dev,
+					struct cpuidle_driver *drv, int idx)
+{
+	/* No PSCI CPU_SUSPEND or deeper hardware state is requested. */
+	cpu_do_idle();
+	return idx;
+}
+
+static const struct of_device_id psci_idle_state_match[] = {
 	{ .compatible = "arm,idle-state",
 	  .data = psci_enter_idle_state },
 	{ },
@@ -382,8 +395,10 @@
 	 * PSCI idle states relies on architectural WFI to be represented as

 	 */
-	drv->states[0].enter = psci_enter_idle_state;
-	drv->states[0].exit_latency = 1;
+	drv->states[0].enter = psci_enter_idle_state;
+	if (psci_s2idle_wfi)
+		drv->states[0].enter_s2idle = psci_enter_wfi_s2idle;
+	drv->states[0].exit_latency = 1;
 	drv->states[0].target_residency = 1;

#!/usr/bin/env python3
"""Read the port's public configuration (config.toml) for scripts and CI.

    scripts/config get KEY        one value (dotted: device.id, ui.phosh.title)
    scripts/config shell          CFG_* assignments for eval (lists: space separated)
    scripts/config json           everything, derived values filled in
    scripts/config channels       "ui flavour tag variant" lines, one per update channel
    scripts/config matrix         the image job matrix for GitHub Actions (JSON)
    scripts/config legacy-channels "ui flavour legacy-tag variant tag": where each build is
                                  also published under an earlier image name
    scripts/config variants       "codename id status images models..." lines, one per variant
    scripts/config variant-of M   the variant (codename) of model number M, e.g. SM-T575
    scripts/config check          validate; non-zero exit on an error

Derived values (left empty or out in config.toml) are filled in here and
nowhere else, so every consumer agrees. CONFIG=path reads another file;
GITHUB_REPOSITORY (set in CI) overrides project.repo, so forks publish to
themselves. Needs Python 3.11+ (tomllib), nothing else.

A port covers one board family ([device], device.family) in one or more
variants ([[variant]]: the Wi-Fi and LTE models of one tablet, say). Each
variant has its own codename, device package, images and update channels;
the kernel, boot chain, installer and repository are shared. The default
variant (device.codename) gives the top-level device.id, [android] and the
other single-device keys, so a port with one variant needs no [[variant]].
"""
import json
import os
import re
import shlex
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PATH = Path(os.environ.get("CONFIG", ROOT / "config.toml"))
STATUSES = ("bring-up", "testing", "stable")
FLAVOURS = ("release", "dev")
# identity, keys and owner data: scripts/firmware-snapshot never reads these
# (scripts/firmware-snapshot has the same list)
NEVER_READ = ("efs", "sec_efs", "persistent", "param", "up_param", "keystorage", "keydata",
              "keyrefuge", "steady", "cpefs", "spu", "prism", "optics", "omr", "cm",
              "userdata", "metadata", "persist", "modemst1", "modemst2", "fsg", "frp")
TEMPLATE_VALUES = {"device.vendor": "vendor", "device.codename": "codename", "device.soc": "exynosxxxx"}
# [android] keys that differ between the variants of one family
ANDROID_VARIANT_KEYS = ("product_device", "firmware_pattern", "tested_firmware",
                        "tested_bootloader_rev", "fus_model")


def load():
    with open(PATH, "rb") as f:
        c = tomllib.load(f)
    for s in ("project", "device", "android", "kernel", "images", "ui", "channels",
              "upstream", "update", "bootchain", "installer", "console", "debug_tool"):
        c.setdefault(s, {})
    p, d, u = c["project"], c["device"], c["update"]
    if os.environ.get("GITHUB_REPOSITORY"):
        p["repo"] = os.environ["GITHUB_REPOSITORY"]
    p.setdefault("template", False)
    owner, _, name = p.get("repo", "").partition("/")
    p["owner"], p["name"] = owner, name
    d["id"] = f"{d.get('vendor', '')}-{d.get('codename', '')}"
    c["kernel"]["package"] = c["kernel"].get("package") or f"linux-postmarketos-{d.get('soc', '')}"
    c["kernel"]["aport"] = f"pmos/aports/device/testing/{c['kernel']['package']}"
    c["device"]["package"] = f"device-{d['id']}"
    c["device"]["aport"] = f"pmos/aports/device/testing/device-{d['id']}"
    # the board family: the shared names (installer, boot chain, common
    # device package); a single-device port's family is its codename
    d["family"] = d.get("family") or d.get("codename", "")
    d["family_id"] = f"{d.get('vendor', '')}-{d['family']}"
    d["common_package"] = f"{d['family_id']}-common"
    d["common_aport"] = f"pmos/aports/device/testing/{d['common_package']}"
    load_variants(c)
    u["base"] = u.get("base") or f"https://github.com/{p.get('repo', '')}/releases/download/"
    if not u["base"].endswith("/"):
        u["base"] += "/"
    u["pages"] = (u.get("pages") or f"https://{owner.lower()}.github.io/{name}").rstrip("/")
    u.setdefault("public_key", "pmos/sysupdate-public-key.asc")
    u.setdefault("fingerprint", "")
    # where every image says which channel it follows (mkosi.finalize)
    u["channel_file"] = u.get("channel_file") or f"/usr/lib/{d['id']}/update-channel"
    for v in c["variants"].values():
        v["channel_file"] = v.get("channel_file") or (
            u["channel_file"] if v["default"] else f"/usr/lib/{v['id']}/update-channel")
    c["bootchain"].setdefault("enabled", False)
    # one boot chain for the family: U-Boot picks each variant's DT by model
    c["bootchain"]["tag"] = c["bootchain"].get("tag") or f"{d['family_id']}_bootchain"
    bc = c["bootchain"]
    bc["u_boot_defconfig"] = bc.get("u_boot_defconfig") or f"{d['family']}_defconfig"
    bc["uniloader_defconfig"] = bc.get("uniloader_defconfig") or f"{d['family']}_chain_defconfig"
    bc["dtb"] = bc.get("dtb") or c["variants"][d["codename"]]["dtb"]
    bc["dtbs"] = [v["dtb"] for v in c["variants"].values()]
    bc.setdefault("bringup_config", "bootchain/bringup.config")
    bc.setdefault("f2fs", True)
    c["installer"]["name"] = c["installer"].get("name") or f"{d['family']}-setup"
    im = c["images"]
    im.setdefault("release", "edge")
    im.setdefault("uis", [])
    im.setdefault("extra_packages", [])
    im.setdefault("dev_packages", [])
    for ui in im["uis"]:
        t = c["ui"].setdefault(ui, {})
        t.setdefault("title", ui.capitalize())
        t.setdefault("description", "")
    dt = c["debug_tool"]
    # setup.sh offers the shared USB debug tool (root console over USB, the
    # tab CLI) from this remote; ask = false installs it without asking
    dt.setdefault("ask", True)
    dt["remote"] = (dt.get("remote") or "https://github.com/exynos-linux/usb-debug").rstrip("/")
    dt.setdefault("version", "")
    # sha256 of install.sh: setup.sh verifies it before running it ("" = no check)
    dt.setdefault("sha256", "")
    # a pinned version comes from that release, else from the main branch
    dt["setup"] = dt.get("setup") or (
        f"{dt['remote']}/releases/download/{dt['version']}/install.sh" if dt["version"]
        else f"{dt['remote']}/raw/main/install.sh")
    ch = c["channels"]
    ch.setdefault("dev", True)
    ch.setdefault("release", True)
    ch.setdefault("keep", 2)
    fw = c.setdefault("firmware", {})
    fw.setdefault("dir", "firmware")
    for k in ("snapshot", "stock", "re"):
        fw[f"{k}_dir"] = fw.get(f"{k}_dir") or f"{fw['dir']}/{k}"
    fw.setdefault("snapshot_partitions", ["boot", "init_boot", "vendor_boot", "dtbo", "dtb", "recovery", "vbmeta"])
    fw.setdefault("extract_partitions", ["vendor", "odm", "vendor_dlkm"])
    return c


def load_variants(c):
    """[[variant]] tables -> c["variants"] (by codename), derived values filled.

    Without [[variant]] the port is one variant made of [device] and
    [android]. The default variant (device.codename, else the first) also
    fills [android] and device.codename, which single-device code reads.
    """
    d, kpkg = c["device"], c["kernel"]["package"]
    raw = c.pop("variant", None)
    if raw is not None and not isinstance(raw, list):
        # [variant] instead of [[variant]]: report it, carry on as one variant
        c["_variant_error"] = "variant must be an array of tables: [[variant]], not [variant]"
        raw = None
    if not raw:
        raw = [{"codename": d.get("codename", ""), "name": d.get("name", ""),
                "models": list(d.get("models", [])), "status": d.get("status", ""),
                "android": {k: c["android"][k] for k in ANDROID_VARIANT_KEYS if k in c["android"]}}]
    if not isinstance(raw, list):
        raw = []
    family_android = {k: v for k, v in c["android"].items() if k not in ANDROID_VARIANT_KEYS}
    variants = {}
    for v in raw:
        v = dict(v)
        cn = v.get("codename", "")
        v.setdefault("name", d.get("name", ""))
        v.setdefault("models", [])
        v.setdefault("status", d.get("status", ""))
        # the SoC's modem is used (LTE); also what the installer warns about
        v.setdefault("modem", False)
        # CI builds and publishes this variant's images and channels
        v.setdefault("images", True)
        # U-Boot's board table matches it by the S-Boot model prefix
        v.setdefault("u_boot_match", "")
        v["android"] = {**family_android, **v.get("android", {})}
        v["id"] = f"{d.get('vendor', '')}-{cn}"
        # the images' name (IMAGE_ID: release tags, asset and UKI names)
        v["image_id"] = v.get("image_id") or v["id"]
        # earlier image names: CI keeps publishing under them and the images
        # still recognise files installed under them; delete when no tablet
        # runs such an image any more
        v.setdefault("legacy_image_ids", [])
        v["package"] = f"device-{v['id']}"
        v["aport"] = f"pmos/aports/device/testing/device-{v['id']}"
        v["dtb"] = v.get("dtb") or f"exynos/{d.get('soc', '')}-{cn}.dtb"
        # the kernel subpackage with only this variant's DTB, so each image's
        # UKI has one unconditional .dtb section
        v["kernel_dtb_package"] = f"{kpkg}-{cn}"
        if cn in variants:
            c.setdefault("_variant_dups", []).append(cn)
        else:
            variants[cn] = v
    if variants and d.get("codename") not in variants:
        d["codename"] = next(iter(variants))
    for cn, v in variants.items():
        v["default"] = cn == d.get("codename")
    d["id"] = f"{d.get('vendor', '')}-{d.get('codename', '')}"
    c["device"]["package"] = f"device-{d['id']}"
    c["device"]["aport"] = f"pmos/aports/device/testing/device-{d['id']}"
    if variants:
        c["android"] = dict(variants[d["codename"]]["android"])
        if not d.get("models"):
            d["models"] = [m for v in variants.values() for m in v["models"]]
    c["variants"] = variants


def variant_of(c, model):
    """The codename of the variant a model number belongs to, or None."""
    for cn, v in c["variants"].items():
        if model in v["models"]:
            return cn
    return None


def get(c, key):
    v = c
    for part in key.split("."):
        if not isinstance(v, dict) or part not in v:
            raise KeyError(key)
        v = v[part]
    return v


def channels(c, legacy=False):
    """(ui, flavour, tag, variant): the sysupdate source directory %M_%W_%w
    (IMAGE_ID = the variant's image_id), + -dev. Only variants with images.
    legacy: (ui, flavour, legacy tag, variant, tag) for every legacy name."""
    out = []
    for cn, v in c["variants"].items():
        if not v["images"]:
            continue
        for ui in c["images"]["uis"]:
            for fl in FLAVOURS:
                if not c["channels"].get(fl):
                    continue
                sfx = f"_{ui}_{c['images']['release']}" + ("-dev" if fl == "dev" else "")
                tag = v["image_id"] + sfx
                if legacy:
                    out += [(ui, fl, old + sfx, cn, tag) for old in v["legacy_image_ids"]]
                else:
                    out.append((ui, fl, tag, cn))
    return out


def flat(prefix, v, out):
    if isinstance(v, dict):
        for k, x in v.items():
            flat(f"{prefix}_{k}" if prefix else k, x, out)
    else:
        if isinstance(v, bool):
            v = "true" if v else "false"
        elif isinstance(v, list):
            v = " ".join(str(x) for x in v)
        out[re.sub(r"[^A-Za-z0-9]", "_", prefix).upper()] = str(v)


def gitignored(rel):
    """True if git would not commit files under rel (or git is unavailable)."""
    try:
        r = subprocess.run(["git", "-C", str(ROOT), "check-ignore", "-q", "--", f"{rel.rstrip('/')}/x"],
                           capture_output=True)
    except OSError:
        return True
    # 128: not a git checkout (a release tarball): nothing can be committed
    return r.returncode in (0, 128)


def check(c):
    errs, warns = [], []
    e, w = errs.append, warns.append
    p, d, im = c["project"], c["device"], c["images"]
    if c.get("schema") != 1:
        e("schema must be 1")
    if not re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+", p.get("repo", "")):
        e("project.repo must be owner/name")
    for k in ("vendor", "codename"):
        if not re.fullmatch(r"[a-z0-9]+", d.get(k, "")):
            e(f"device.{k} must be lower case letters and digits")
    if not re.fullmatch(r"[a-z0-9]+", d.get("soc", "")):
        e("device.soc must be lower case letters and digits")
    if not re.fullmatch(r"https://[^\s]+", c["debug_tool"]["remote"]):
        e("debug_tool.remote must be an https URL")
    if not isinstance(c["debug_tool"]["ask"], bool):
        e("debug_tool.ask must be true or false")
    if c["debug_tool"]["sha256"] and not re.fullmatch(r"[0-9a-f]{64}", c["debug_tool"]["sha256"]):
        e("debug_tool.sha256 must be 64 lower case hex digits or empty")
    if d.get("arch") != "aarch64":
        e("device.arch: only aarch64 is supported")
    if d.get("status") not in STATUSES:
        e(f"device.status must be one of {', '.join(STATUSES)}")
    if not d.get("models"):
        e("device.models is empty")
    if not re.fullmatch(r"[a-z0-9]+", d.get("family", "")):
        e("device.family must be lower case letters and digits")
    if c.get("_variant_error"):
        e(c["_variant_error"])
    for cn in c.get("_variant_dups", []):
        e(f"variant {cn!r} is defined twice")
    seen_models = {}
    for cn, v in c["variants"].items():
        if not re.fullmatch(r"[a-z0-9]+", cn):
            e(f"variant {cn!r}: codename must be lower case letters and digits")
        if v["status"] not in STATUSES:
            e(f"variant {cn}: status must be one of {', '.join(STATUSES)}")
        if not v["models"]:
            e(f"variant {cn}: models is empty")
        for m in v["models"]:
            if not re.fullmatch(r"[A-Z]{2}-[A-Z0-9]+", m):
                e(f"variant {cn}: bad model number {m!r}")
            if m in seen_models:
                e(f"model {m} is in variants {seen_models[m]} and {cn}")
            seen_models[m] = cn
            if m not in d["models"]:
                e(f"variant {cn}: model {m} is missing from device.models")
        for k in ("modem", "images"):
            if not isinstance(v[k], bool):
                e(f"variant {cn}: {k} must be true or false")
        if v["u_boot_match"] and not all(m.removeprefix("SM-").startswith(v["u_boot_match"])
                                         for m in v["models"]):
            e(f"variant {cn}: u_boot_match {v['u_boot_match']!r} is not a prefix of every model")
        try:
            pat = re.compile(v["android"].get("firmware_pattern", ""))
        except re.error as x:
            e(f"variant {cn}: android.firmware_pattern: {x}")
        else:
            t = v["android"].get("tested_firmware", "")
            if t and not pat.fullmatch(t):
                e(f"variant {cn}: tested_firmware {t} does not match firmware_pattern")
        if not re.fullmatch(r"[a-z0-9][a-z0-9.-]*", v["image_id"]):
            e(f"variant {cn}: image_id must be lower case letters, digits, '.' and '-'")
        for old in v["legacy_image_ids"]:
            if not re.fullmatch(r"[a-z0-9][a-z0-9.-]*", str(old)) or old == v["image_id"]:
                e(f"variant {cn}: bad legacy_image_ids entry {old!r}")
        if v["status"] == "bring-up" and v["images"] and c["channels"].get("release"):
            w(f"variant {cn} is in bring-up but publishes images (images = true)")
    names = [n for v in c["variants"].values() for n in [v["image_id"], *v["legacy_image_ids"]]]
    for n in sorted({n for n in names if names.count(n) > 1}):
        e(f"image name {n} is used by more than one variant")
    if not any(v["images"] for v in c["variants"].values()):
        e("no variant publishes images (variant.images)")
    if not re.fullmatch(r"edge|v[0-9]{2}\.[0-9]{2}", im["release"]):
        e("images.release must be edge or vYY.MM")
    if not im["uis"]:
        e("images.uis is empty")
    for ui in im["uis"]:
        if not re.fullmatch(r"[a-z0-9-]+", ui):
            e(f"images.uis: bad UI id {ui!r}")
    if im.get("default_ui") not in im["uis"]:
        e("images.default_ui must be one of images.uis")
    for k in ("extra_packages", "dev_packages"):
        for n in im[k]:
            if not re.fullmatch(r"[a-z0-9][a-z0-9._+-]*", n):
                e(f"images.{k}: bad package name {n!r}")
    for k in ("debug_package_regex", "debug_file_regex"):
        try:
            re.compile(im.get(k, ""))
        except re.error as x:
            e(f"images.{k}: {x}")
    try:
        re.compile(c["android"].get("firmware_pattern", ""))
    except re.error as x:
        e(f"android.firmware_pattern: {x}")
    if not isinstance(c["channels"]["keep"], int) or c["channels"]["keep"] < 1:
        e("channels.keep must be a positive integer")
    if not channels(c):
        e("no update channel: enable channels.dev and/or channels.release")
    fpr = c["update"]["fingerprint"]
    if fpr and not re.fullmatch(r"[0-9A-F]{40}", fpr):
        e("update.fingerprint must be 40 upper case hex digits")
    inst = c["installer"]
    prot = inst.get("protected", [])
    if not prot:
        e("installer.protected is empty (the installer then refuses every write)")
    for n in prot:
        if n != n.lower():
            e(f"installer.protected: {n!r} must be lower case")
    for n in inst.get("flash_allow", []):
        if n.lower() in prot:
            e(f"installer.flash_allow: {n} is a protected partition")
    if not re.fullmatch(r"[0-9a-f]{4}:[0-9a-f]{4}", inst.get("download_usb", "")):
        e("installer.download_usb must be vvvv:pppp (hex)")
    # the installer's guard limits console writes to this disk's partitions
    if not re.fullmatch(r"[a-z]+[0-9]*", inst.get("main_disk", "")):
        e("installer.main_disk must be a whole-disk name like sda or mmcblk0")
    bpb = inst.get("boot_partition_bytes", 0)
    if not isinstance(bpb, int) or isinstance(bpb, bool) or bpb < 0 or bpb % 512:
        e("installer.boot_partition_bytes must be 0 or a positive multiple of 512")
    if inst.get("sector_size", 4096) not in (512, 4096):
        e("installer.sector_size must be 512 or 4096")
    for n in inst.get("backup_readonly", []):
        if not re.fullmatch(r"[a-z0-9_]+", n):
            e(f"installer.backup_readonly: {n!r} must be a lower case partition name")
    a = c["android"]
    opts, feat = a.get("userdata_f2fs_options", ""), a.get("userdata_f2fs_features", "")
    if bool(opts) != bool(feat):
        e("android.userdata_f2fs_options and userdata_f2fs_features: set both or neither")
    if len(opts.split()) > 5:
        e("android.userdata_f2fs_options: at most 5 words (the console runs at most 7 arguments)")
    if feat and not re.fullmatch(r"0x[0-9a-f]+", feat):
        e("android.userdata_f2fs_features must be lower case hex like 0x499")
    fw = c["firmware"]
    for k in ("dir", "snapshot_dir", "stock_dir", "re_dir"):
        v = fw[k]
        if not isinstance(v, str) or not v or v.startswith("/") or ".." in Path(v).parts:
            e(f"firmware.{k} must be a path inside the repo")
        elif not gitignored(v):
            e(f"firmware.{k}: {v}/ is not gitignored (Samsung's files must never be committed)")
    for k in ("snapshot_partitions", "extract_partitions"):
        for n in fw[k]:
            if not re.fullmatch(r"[a-z0-9_]+", str(n)):
                e(f"firmware.{k}: {n!r} must be a lower case partition name")
    for n in fw["snapshot_partitions"]:
        if str(n).removesuffix("_a").removesuffix("_b") in NEVER_READ:
            e(f"firmware.snapshot_partitions: {n} holds identity or owner data and is never read")
    if not p["template"]:
        for k, v in TEMPLATE_VALUES.items():
            if get(c, k) == v:
                e(f"{k} still has the template value {v!r} (scripts/init-device)")
        if not fpr:
            w("update.fingerprint is empty: run scripts/new-signing-key before publishing")
        if not (ROOT / c["kernel"]["aport"] / "APKBUILD").is_file():
            w(f"no kernel aport {c['kernel']['aport']}")
        for v in c["variants"].values():
            if not (ROOT / v["aport"] / "APKBUILD").is_file():
                w(f"no device aport {v['aport']}")
    return errs, warns


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    cmd, args = sys.argv[1], sys.argv[2:]
    c = load()
    if cmd == "get":
        try:
            v = get(c, args[0])
        except (KeyError, IndexError):
            sys.exit(f"scripts/config: no key {args[0] if args else ''!r}")
        if isinstance(v, list):
            print("\n".join(str(x) for x in v))
        elif isinstance(v, bool):
            print("true" if v else "false")
        elif isinstance(v, dict):
            print(json.dumps(v, indent=2))
        else:
            print(v)
    elif cmd == "shell":
        out = {}
        flat("cfg", c, out)
        for k, v in out.items():
            print(f"{k}={shlex.quote(v)}")
    elif cmd == "json":
        print(json.dumps(c, indent=2))
    elif cmd == "channels":
        for ui, fl, tag, cn in channels(c):
            print(ui, fl, tag, cn)
    elif cmd == "matrix":
        print(json.dumps({"include": [
            {"ui": ui, "channel": fl, "tag": tag, "variant": cn, "device": c["variants"][cn]["id"],
             "image_id": c["variants"][cn]["image_id"],
             "legacy": ",".join(c["variants"][cn]["legacy_image_ids"])}
            for ui, fl, tag, cn in channels(c)]}))
    elif cmd == "legacy-channels":
        for row in channels(c, legacy=True):
            print(*row)
    elif cmd == "variants":
        for cn, v in c["variants"].items():
            print(cn, v["id"], v["status"], "true" if v["images"] else "false", *v["models"])
    elif cmd == "variant-of":
        if not args:
            sys.exit("scripts/config variant-of MODEL")
        cn = variant_of(c, args[0])
        if cn is None:
            sys.exit(1)
        print(cn)
    elif cmd == "check":
        errs, warns = check(c)
        for x in warns:
            print(f"warning: {x}", file=sys.stderr)
        for x in errs:
            print(f"error: {x}", file=sys.stderr)
        if errs:
            sys.exit(1)
        print(f"{PATH.name}: ok ({c['device']['family_id']}: {', '.join(c['variants'])};"
              f" {len(channels(c))} channels)")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()

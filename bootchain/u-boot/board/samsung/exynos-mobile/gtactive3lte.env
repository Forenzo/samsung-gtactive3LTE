/*
 * Samsung Galaxy Tab Active3 LTE (SM-T575) EXPERIMENTAL FIRST HANDOFF.
 *
 * This environment must NOT inherit the SM-T570's production bootcmd.
 * Our first U-Boot handoff is deliberately inspection-only: don't read a
 * nested Duranium GPT, don't boot systemd-boot, and don't flash userdata.
 *
 * The LTE uniLoader board does NOT yet implement watchdog/Volume Down
 * fallback, so even this menu is NOT proof of automatic recovery.
 * The host must retain verified Android and Linux diagnostic BOOT images,
 * with manual Samsung Download Mode/Heimdall recovery available.
 *
 * No screen or button input is guaranteed to work on the physical T575.
 * The menu is for the bootloader phase; finger touch and Wacom S Pen need
 * the separate Linux/Phosh drivers, not this U-Boot environment.
 */
stdin=button-kbd
stdout=vidconsole
stderr=vidconsole
bootdelay=-2
bootmenu_delay=30

bootcmd=echo "SM-T575 LTE RESEARCH BOOTCHAIN - NO PHOSH INSTALL OR USERDATA WRITE";
	echo "LTE board selection and menu navigation are untested";
	bdinfo;
	echo "Inspection menu: automatic warm reset after 30 seconds if no selection";
	bootmenu 30;
	reset

/*
 * Entry 0 is deliberately a reset: leaving the menu unattended attempts
 * a warm reboot, so uniLoader can see its previous CHAIN_STAGE_JUMP and
 * select embedded diagnostic Linux on the next boot (RAM retention is not
 * yet proven on T575). This is NOT an automatic hung-U-Boot fallback.
 *
 * Avoid prolonged physical button holds; Samsung Download Mode may
 * intercept those before U-Boot receives a key event.
 */
bootmenu_0=Warm reset (attempt Linux fallback)=reset
bootmenu_1=Show U-Boot board and DRAM=bdinfo; bootmenu 30
bootmenu_2=Show EFI memory map=efidebug memmap; bootmenu 30
/*
 * Compact UFS inspection. Never dump all 39 GPT entries automatically.
 * The original menu printed 127 missing-LUN OCS errors on physical T575.
 * This read-only action reports only BOOT=12 and userdata=31 geometry,
 * and returns to the proven timed-recovery menu. No storage writes.
 */
lte_ufs_summary=echo "SM-T575 UFS targeted geometry (READ ONLY)";
	if run lte_ufs_scan &&
	   part start scsi 0 12 t575_boot_lba &&
	   part size scsi 0 12 t575_boot_sectors &&
	   part start scsi 0 31 t575_data_lba &&
	   part size scsi 0 31 t575_data_sectors; then
		printenv t575_boot_lba t575_boot_sectors t575_data_lba t575_data_sectors;
		echo "Expected for UFS 4KiB blocks: BOOT size 0x3b00, userdata size 0xce9c00";
	else
		echo "UFS partition query FAILED; native EFI must not be attempted";
	fi;
	bootmenu 30

bootmenu_3=Show BOOT and userdata UFS geometry (READ ONLY)=run lte_ufs_summary
bootmenu_4=Re-enter inspection menu=bootmenu 30

/*
 * EXPLICIT OPT-IN NATIVE PHOSH HANDOFF (no automatic boot).
 *
 * This is disabled by default: the menu timeout still selects item 0
 * (the already tested warm return to diagnostic Linux). Once an LTE-only
 * installer has verified and written the nested 4 KiB GPT disk to sda31,
 * a human may select this item to try its ESP's default ARM64 EFI binary.
 *
 * This does NOT modify the GPT or any block-device contents. blkmap maps
 * the userdata sector span in RAM. Board name comes from U-Boot's
 * model-specific Exynos board selection; use no Wi-Fi fallback.
 */
ud_part=31
esp_part=1
kernel_addr_r=0x90000000

lte_ufs_scan=ufs init && scsi scan

lte_phosh_boot=echo "SM-T575 LTE: explicit read-only Phosh EFI handoff";
	if test "${board}" != gtactive3; then
		echo "REFUSED: selected U-Boot board is not gtactive3";
	else
		if run lte_ufs_scan &&
		   part start scsi 0 ${ud_part} ud_start &&
		   part size scsi 0 ${ud_part} ud_size; then
			echo "SM-T575: probing nested userdata GPT";
			blkmap create lteuserdata;
			blkmap map lteuserdata 0 0x${ud_size} linear scsi 0 0x${ud_start};
			if blkmap get lteuserdata dev ud_dev &&
			   part list blkmap ${ud_dev} &&
			   load blkmap ${ud_dev}:${esp_part} ${kernel_addr_r} EFI/BOOT/BOOTAA64.EFI; then
				echo "SM-T575: starting Phosh EFI from userdata ESP";
				bootefi ${kernel_addr_r};
			else
				echo "SM-T575: EFI file unavailable; no disk writes performed";
			fi;
		else
			echo "SM-T575: UFS/partition 31 unavailable; no disk writes performed";
		fi;
	fi;
	echo "SM-T575: returning to U-Boot inspection menu";
	bootmenu 30

bootmenu_5=TRY native Phosh EFI (explicit; requires installed userdata)=run lte_phosh_boot
bootmenu_6=Full UFS GPT listing (verbose; READ ONLY)=run lte_ufs_scan; part list scsi 0; bootmenu 30

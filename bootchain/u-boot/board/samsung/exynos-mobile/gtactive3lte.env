/*
 * Samsung Galaxy Tab Active3 LTE (SM-T575)
 * Native Linux boot menu.
 *
 * Native EFI boot is the default.
 * Recovery tools remain available without a countdown.
 * No new storage or PMU register write commands.
 */

stdin=button-kbd
stdout=vidconsole
stderr=vidconsole
bootdelay=-2
bootmenu_delay=3

ud_part=31
esp_part=1
kernel_addr_r=0x90000000

bootcmd=run t575_menu_controller

t575_menu_controller=echo "Samsung Galaxy Tab Active3 LTE";
	setenv t575_menu main;
	setenv t575_menu_delay 3;
	while true; do
		if test "${t575_menu}" = main; then
			run t575_main_menu;
		else
			run t575_advanced_menu;
		fi;
		setenv bootmenu_default 0;
		bootmenu ${t575_menu_delay};
		setenv t575_menu_delay -1;
	done

t575_main_menu=setenv bootmenu_0 'Boot Native Linux=setenv t575_menu advanced; run lte_phosh_boot';
	setenv bootmenu_1 'Advanced / Recovery=setenv t575_menu advanced';
	setenv bootmenu_2 'Reboot=reset';
	setenv bootmenu_3;
	setenv bootmenu_4;
	setenv bootmenu_5;
	setenv bootmenu_6;
	setenv bootmenu_7

t575_advanced_menu=setenv bootmenu_0 'Return to main menu=setenv t575_menu main';
	setenv bootmenu_1 'Warm reset (attempt diagnostic fallback)=reset';
	setenv bootmenu_2 'Board and DRAM information=bdinfo';
	setenv bootmenu_3 'EFI memory map=efidebug memmap';
	setenv bootmenu_4 'UFS partition geometry (READ ONLY)=run lte_ufs_summary';
	setenv bootmenu_5 'Full UFS GPT listing (READ ONLY)=run lte_ufs_scan; part list scsi 0';
	setenv bootmenu_6 'Read-only BOOT sector test=run lte_ufs_boot_read';
	setenv bootmenu_7

lte_ufs_scan=ufs init && scsi scan

lte_phosh_boot=echo "SM-T575 LTE: explicit read-only Phosh EFI handoff";
	if test "${board}" != gtactive3; then
		echo "REFUSED: selected U-Boot board is not gtactive3";
	else
		if run lte_ufs_scan &&
		   part start scsi 0 ${ud_part} ud_start &&
		   part size scsi 0 ${ud_part} ud_size; then
			echo "SM-T575: probing nested userdata GPT";
			blkmap create lteuserdata;
			blkmap map lteuserdata 0 0x${ud_size} linear scsi 0 0x${ud_start};
			if blkmap get lteuserdata dev ud_dev &&
			   part list blkmap ${ud_dev} &&
			   load blkmap ${ud_dev}:${esp_part} ${kernel_addr_r} EFI/BOOT/BOOTAA64.EFI; then
				echo "SM-T575: starting Phosh EFI from userdata ESP";
				bootefi ${kernel_addr_r};
			else
				echo "SM-T575: EFI file unavailable; no disk writes performed";
			fi;
		else
			echo "SM-T575: UFS/partition 31 unavailable; no disk writes performed";
		fi;
	fi;
	echo "SM-T575: EFI handoff returned; entering recovery";
	true

lte_ufs_summary=echo "SM-T575 UFS targeted geometry (READ ONLY)";
	if run lte_ufs_scan &&
	   part start scsi 0 12 t575_boot_lba &&
	   part size scsi 0 12 t575_boot_sectors &&
	   part start scsi 0 31 t575_data_lba &&
	   part size scsi 0 31 t575_data_sectors; then
		printenv t575_boot_lba t575_boot_sectors t575_data_lba t575_data_sectors;
		echo "Expected for UFS 4KiB blocks: BOOT size 0x3b00, userdata size 0xce9c00";
	else
		echo "UFS partition query FAILED; native EFI must not be attempted";
	fi;
	true

lte_ufs_boot_read=echo "SM-T575 ONE-SECTOR BOOT READ (READ ONLY)";
	if run lte_ufs_scan &&
	   part start scsi 0 12 t575_boot_lba &&
	   part size scsi 0 12 t575_boot_sectors; then
		printenv t575_boot_lba t575_boot_sectors;
		if test "${t575_boot_lba}" = "6c90" &&
		   test "${t575_boot_sectors}" = "3b00"; then
			if scsi device 0 &&
			   scsi read ${kernel_addr_r} ${t575_boot_lba} 1; then
				echo "UFS BLOCK READ PASS; first 16 bytes should be ANDROID! (41 4e 44 52 4f 49 44 21)";
				md.b ${kernel_addr_r} 0x10;
			else
				echo "UFS BLOCK READ FAILED; EFI boot still blocked";
			fi;
		else
			echo "STOP: unexpected BOOT GPT geometry; read was not attempted";
		fi;
	else
		echo "STOP: UFS scanning or BOOT GPT lookup failed; read was not attempted";
	fi;
	true

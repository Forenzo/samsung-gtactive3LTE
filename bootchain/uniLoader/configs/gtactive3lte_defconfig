# SM-T575 passive uniLoader board prototype; compile-only / NOT FLASHABLE
# Inherited addresses are hypotheses pending DRAM, S-Boot and memory-owner audit.
CONFIG_POSITION_INDEPENDENT=y
# Standard AArch64 Image header at BOOT kernel payload offset 0x38.
# S-Boot acceptance is still unknown; this is a compatibility prerequisite.
CONFIG_LINUX_KRNL_HEADER_IMG=y
CONFIG_EXYNOS_9810=y
CONFIG_SAMSUNG_GTACTIVE3LTE=y
CONFIG_TEXT_BASE=0x87000000
CONFIG_PAYLOAD_ENTRY=0x90000000
CONFIG_RAMDISK_ENTRY=0x84000000
CONFIG_FRAMEBUFFER_BASE=0xca000000
CONFIG_FRAMEBUFFER_WIDTH=1200
CONFIG_FRAMEBUFFER_HEIGHT=1920
CONFIG_FRAMEBUFFER_STRIDE=4
# The LTE board has no framebuffer device or DECON MMIO setup yet.
# Chainloading and watchdog/reset routines stay disabled until validated.
# CONFIG_CHAINLOAD is not set

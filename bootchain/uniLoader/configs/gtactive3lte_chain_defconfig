# EXPERIMENTAL SM-T575 LTE U-Boot chain: same memory layout as the
# confirmed SM-T570 chain, but model-specific Samsung uniLoader board.
# BOOT-only/offline review. Actual LTE U-Boot handoff not yet device-tested.
CONFIG_POSITION_INDEPENDENT=y
CONFIG_LINUX_KRNL_HEADER_IMG=y
CONFIG_EXYNOS_9810=y
CONFIG_SAMSUNG_GTACTIVE3LTE=y
CONFIG_TEXT_BASE=0x87000000
CONFIG_PAYLOAD_ENTRY=0x90000000
CONFIG_RAMDISK_ENTRY=0x84000000
CONFIG_FRAMEBUFFER_BASE=0xca000000
CONFIG_FRAMEBUFFER_WIDTH=1200
CONFIG_FRAMEBUFFER_HEIGHT=1920
CONFIG_FRAMEBUFFER_STRIDE=4
CONFIG_CHAINLOAD=y
CONFIG_CHAINLOAD_PATH="blob/u-boot.bin"
CONFIG_CHAINLOAD_ENTRY=0xa0000000
CONFIG_CHAINLOAD_FDT_ADDR=0xa8000000
CONFIG_CHAINLOAD_HANDOFF_ADDR=0x8ff1ff000
CONFIG_CHAINLOAD_DEFAULT=0

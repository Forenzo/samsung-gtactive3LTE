/*
 * Samsung Galaxy Tab Active3 LTE SM-T575: first-stage compile-only DT.
 *
 * This inherits the exact SM-T570 Linux DT from the packaged postmarketOS
 * kernel patch. Different upstream development revisions may not expose
 * the same labels. Only board identification is overridden here.
 *
 * Not a validated hardware description or flashable image. Specifically,
 * the inherited hardware configuration has NOT been verified on the LTE
 * variant; do not use this DTB to boot the tablet.
 */
#include "exynos9810-gtactive3wifi.dts"

/ {
	model = "Samsung Galaxy Tab Active3 LTE (SM-T575)";
	compatible = "samsung,gtactive3lte", "samsung,exynos9810";

	/* Exclude LTE modem / coprocessor RAM even while their drivers are off. */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Samsung stock FDT reserves the entire 20 MiB S-Boot handover
		 * framebuffer, not just the 1200x1920x4 visible pixel bytes.
		 * Extend the inherited T570 reservation to avoid allocations
		 * into the unused tail while the bootloader may own it.
		 */
		framebuffer@ca000000 {
			reg = <0x0 0xca000000 0x01400000>;
			no-map;
		};

		t575_modem_mem: modem@f0000000 {
			reg = <0x0 0xf0000000 0x09200000>;
			no-map;
		};

		t575_modem_log: modem-log@f9200000 {
			reg = <0x0 0xf9200000 0x02000000>;
			no-map;
		};

		/* Vendor A-Box firmware region: DT node name differs from reg. */
		t575_abox_mem: abox@fb200000 {
			reg = <0x0 0xfb200000 0x02800000>;
			no-map;
		};
	};
};

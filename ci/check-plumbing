#!/bin/sh
# The plumbing reads config.toml (scripts/config): no file in it may name
# the repository's old homes again (dixonSolutions/gtactive3-mainline until
# 2026-10-23, exynos-linux/samsung-gtactive3wifi until 2026-11-11; the
# handoff's dated history may),
# and config.toml must be valid. Exported patch series (pmos/) keep their
# history and are not checked.
set -eu
cd "$(dirname "$0")/.."
scripts/config check
old='dixonsolutions\.github\.io|github\.com/dixonSolutions/gtactive3-mainline|repos/dixonSolutions/gtactive3-mainline'
old="$old|exynos-linux\.github\.io/samsung-gtactive3wifi|github\.com/exynos-linux/samsung-gtactive3wifi|repos/exynos-linux/samsung-gtactive3wifi"
if git ls-files -- ci .github scripts tests config.toml README.md docs |
	grep -v -e '^ci/check-plumbing$' -e '^docs/AGENT-HANDOFF.md$' | xargs grep -nIE "$old" -- 2>/dev/null; then
	echo "check-plumbing: the lines above still point at the old home (use config.toml)" >&2
	exit 1
fi
echo "check-plumbing: ok"

#!/bin/sh
# The published update channels: one GitHub release each, named like the
# sysupdate source directory %M_%W_%w (IMAGE_ID_VARIANT_ID_VERSION_ID) plus
# "-dev" for the development images (contrib/samsung-gtactive3/
# mkosi.finalize in duranium-build). Columns: ui channel tag variant. From
# config.toml (variants with images = true, images.uis, images.release,
# channels).
exec "$(dirname "$0")/../scripts/config" channels

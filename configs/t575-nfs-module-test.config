# Experimental build of NFSv3 as loadable modules for the mainline diagnostic kernel.
# Does not alter or replace the existing running kernel or partition images.
# Kernel compatibility with the physical tablet must be verified before insmod.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=m
CONFIG_NFS_V3=y
# NFS4 and optional client infrastructure deliberately disabled for this probe.
# CONFIG_NFS_V4 is not set
# CONFIG_NFS_V4_1 is not set
# CONFIG_NFS_V4_2 is not set
# CONFIG_NFS_SWAP is not set
# CONFIG_NFS_USE_KERNEL_DNS is not set
CONFIG_SUNRPC=m
CONFIG_LOCKD=m
CONFIG_GRACE_PERIOD=m

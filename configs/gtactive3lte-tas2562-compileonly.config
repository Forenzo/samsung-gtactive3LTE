# SM-T575 LTE TAS2562 codec — compile-only, NOT bootable configuration.
#
# Stage 43. This is an isolated fragment, not the existing Wi-Fi bringup
# config; never use to build a flashable image. The T575 DTS continues to
# mark TAS2562, the inherited sound card and T570 RT5510 as disabled.
#
# Upstream codec driver: sound/soc/codecs/tas2562.c
# Upstream Kconfig symbol: SND_SOC_TAS2562 (depends on I2C).
# Selecting m compiles a codec module; it does not enable a DT node.
CONFIG_I2C=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_TAS2562=m

# This fragment intentionally does NOT select or activate the T570
# RT5510/MT6660 machine path or modify the common Wi-Fi configuration.

# EXPERIMENTAL ONLY: merge atop the proven diagnostic kernel config.
# Not wired into the default diagnostic BOOT image or flashing workflows.
# USB NCM is brought up by the existing diagnostic init; only *after* the
# USB network is ready can userspace request a host-backed NFS mount.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=n
CONFIG_NFS_SWAP=n
CONFIG_NFS_USE_KERNEL_DNS=n
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
# Use an NFSv3 read-only root with RAM writable mounts on the tablet.
# No CONFIG_ROOT_NFS is requested: the USB gadget must come up first.

+#!/bin/sh
+# Device hook, run at the end of the top-level mkosi.finalize (before /etc
+# moves into the base confext and before the usr partition and its verity
+# hash are made).
+#
+# Update server: gtactive3-mainline publishes its own images (our kernel and
+# drivers on top of the postmarketOS packages) as GitHub releases, one
+# release per update channel:
+#
+#   https://github.com/exynos-linux/samsung-gtactive3wifi/releases/download/
+#       samsung-gtactive3wifi_<ui>_<release><suffix>/SHA256SUMS(.gpg)
+#
+# so sysupdate here must never fetch postmarketOS's generic images (they
+# carry no kernel for this device), and must only trust manifests signed
+# with the project's key:
+#
+#  - every sysupdate.d transfer that points at the postmarketOS image server
+#    points at the release of this image's channel instead
+#  - the sysupdate keyring holds only sysupdate-public-key.asc
+#
+# GTA3_CHANNEL: "" (release images) or "dev" (development images with the
+# USB debug layer, channel tag suffix "-dev"). GTA3_UPDATE_BASE overrides
+# the server: gtactive3-mainline's CI sets it from its config.toml
+# (update.base); build-image.sh passes it through to mkosi.
+# GTA3_CHANNEL_FILE: where the image records its channel (config.toml
+# variants.<codename>.channel_file); the Wi-Fi variant keeps its historic
+# /usr/lib/gtactive3wifi/update-channel.
+#
+# One hook for every variant: contrib/<PMOS_DEVICE>/mkosi.finalize is this
+# file (samsung-gtactive3, the LTE variant) or a link to it.
+set -eu
+
+HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
+BASE=${GTA3_UPDATE_BASE:-https://github.com/exynos-linux/samsung-gtactive3wifi/releases/download/}
+case "$PMOS_DEVICE" in
+samsung-gtactive3wifi) CHFILE=${GTA3_CHANNEL_FILE:-/usr/lib/gtactive3wifi/update-channel} ;;
+*) CHFILE=${GTA3_CHANNEL_FILE:-/usr/lib/$PMOS_DEVICE/update-channel} ;;
+esac
+case "${GTA3_CHANNEL:-}" in
+	"") suffix= ;;
+	dev) suffix=-dev ;;
+	*) echo "GTA3_CHANNEL must be empty or dev, not '$GTA3_CHANNEL'" >&2; exit 1 ;;
+esac
+
+n=0
+for t in "$BUILDROOT"/usr/lib/sysupdate.d/*.transfer; do
+	[ -f "$t" ] || continue
+	grep -qE '^Path=https://duranium\.(postmarketos\.org|nura\.eco)/images/' "$t" || continue
+	sed -i -E "s|^Path=https://duranium\.(postmarketos\.org\|nura\.eco)/images/(staging/)?([^/]+)/|Path=${BASE}\3${suffix}/|" "$t"
+	grep -q "^Path=${BASE}" "$t" || { echo "could not rewrite Path= in $t" >&2; exit 1; }
+	n=$((n + 1))
+done
+[ "$n" -gt 0 ] || { echo "no sysupdate transfer pointed at the postmarketOS server" >&2; exit 1; }
+echo "sysupdate: $n transfers -> ${BASE}%M_%W_%w${suffix}/"
+
+# duranium-set-channel only knows the postmarketOS server layout
+# (/images/ vs /images/staging/): on this device it would copy every transfer
+# unchanged into /etc/sysupdate.d, freezing them. Our channels are fixed per
+# image (release or -dev, see update-channel below).
+if [ -f "$BUILDROOT"/usr/bin/duranium-set-channel ]; then
+	cat > "$BUILDROOT"/usr/bin/duranium-set-channel <<'EOF'
+#!/bin/sh
+# Galaxy Tab Active3: one update channel per image (GitHub releases of the
+# port), there is no staging channel. Prints the channel.
+set -eu
+. @CHFILE@
+case "${1:-}" in
+"") echo "$UPDATE_CHANNEL" ;;
+main) echo "$UPDATE_CHANNEL" ;;
+*) echo "this device has no '$1' channel; images follow $UPDATE_CHANNEL" >&2; exit 1 ;;
+esac
+EOF
+	sed -i "s|@CHFILE@|$CHFILE|" "$BUILDROOT"/usr/bin/duranium-set-channel
+	chmod 0755 "$BUILDROOT"/usr/bin/duranium-set-channel
+fi
+
+# A plain binary OpenPGP key file is a valid keyring for the gpg that
+# systemd-pull runs. Never "gpg --keyring X --import": a GnuPG 2.4 with a
+# fresh home (CI) keeps keys in keyboxd and silently ignores --keyring, and
+# the image then has no keyring at all (26102201: every update failed with
+# "No OpenPGP keyrings found").
+ring="$BUILDROOT"/usr/lib/systemd/import-pubring.pgp
+rm -f "$ring" "$ring~"
+gpg --dearmor < "$HERE"/sysupdate-public-key.asc > "$ring"
+chmod 0644 "$ring"
+gh=$(mktemp -d)
+n=$(GNUPGHOME=$gh gpg --batch --show-keys --with-colons "$ring" | grep -c '^pub' || true)
+rm -rf "$gh"
+[ "$n" = 1 ] || { echo "$ring must hold exactly one key, has $n" >&2; exit 1; }
+
+# which channel this image follows, for duranium-update and humans
+mkdir -p "$BUILDROOT$(dirname "$CHFILE")"
+printf 'UPDATE_BASE=%s\nUPDATE_CHANNEL=%s_%s_%s%s\n' "$BASE" \
+	"$PMOS_DEVICE" "$PMOS_VARIANT" "${RELEASE:-edge}" "$suffix" \
+	> "$BUILDROOT$CHFILE"

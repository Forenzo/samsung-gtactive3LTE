[Unit]
Description=Duranium USB debug layer: (re)start the debug sockets in the booted system
Documentation=file:///usr/share/doc/duranium-usb-debug/README
ConditionKernelCommandLine=!duranium.usb_debug=0
ConditionPathExists=!/etc/initrd-release
# After switch-root: start ssh and pairing (and, in open mode, the shell,
# the kernel log stream and the device's register console), or apply
# "duranium-usb-debug off" to the gadget the initrd brought up.
After=duranium-usb-debug.service

[Service]
Type=oneshot
ExecStart=-/usr/libexec/duranium/usb-debug-ctl boot

[Install]
WantedBy=multi-user.target

# Dedicated sshd for the Duranium USB debug layer, run in inetd mode (sshd -i)
# from duranium-debug-sshd.socket, which listens on TCP 22 of the USB gadget
# interface only. Its own host key keeps it apart from a production sshd the
# user may run on the system.
#
# Keys only: a computer gets in after it was paired (the owner tapped
# "Allow" on the tablet, usb-debug-pair) or its key was installed by the
# installer. No passwords, so nothing can be guessed over the cable.
# See /usr/share/doc/duranium-usb-debug/README; off with
#   duranium-usb-debug off
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
HostKey /etc/duranium-usb-debug/ssh_host_ed25519_key
# Paired computers in /etc/duranium-usb-debug/authorized_keys (root only),
# keys baked into a bring-up image in /usr/share/duranium-usb-debug, and a
# user's own ~/.ssh/authorized_keys.
AuthorizedKeysFile /etc/duranium-usb-debug/authorized_keys /usr/share/duranium-usb-debug/authorized_keys .ssh/authorized_keys
Subsystem sftp internal-sftp

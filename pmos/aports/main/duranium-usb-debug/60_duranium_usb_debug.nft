#!/usr/sbin/nft -f

# Allow the Duranium USB debug layer only on the USB network interface: ssh
# (22) and pairing (2324); in open mode also the register console (23), the
# kernel log stream (24) and the shell (2323). Never on Wi-Fi or any routable
# link.
table inet filter {
	chain input {
		iifname "usb*" tcp dport { 22, 23, 24, 2323, 2324 } accept comment "duranium-usb-debug"
	}
}

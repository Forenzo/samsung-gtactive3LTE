[Unit]
Description=Duranium USB debug kernel log socket (TCP 24, USB interface only)
Documentation=file:///usr/share/doc/duranium-usb-debug/README
# Unauthenticated root access: only with duranium.usb_debug=open on the
# kernel command line (bring-up images, or typed once in the boot menu's
# editor, which is physical root access anyway). Dev images use ssh.
ConditionKernelCommandLine=duranium.usb_debug=open
DefaultDependencies=no
# "systemctl stop|disable --now duranium-usb-debug.target" stops this too
PartOf=duranium-usb-debug.target
Conflicts=shutdown.target
Before=shutdown.target
After=duranium-usb-debug.service

# Started in the initrd: keep listening across the switch-root isolate
# (the parent target is IgnoreOnIsolate too, so nothing would restart it)
IgnoreOnIsolate=yes

[Socket]
ListenStream=24
BindToDevice=usb0
BindIPv6Only=ipv6-only
Accept=yes
MaxConnections=4

[Install]
WantedBy=duranium-usb-debug.target

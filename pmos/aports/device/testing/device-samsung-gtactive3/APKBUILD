# Reference: <https://postmarketos.org/devicepkg>
#
# Galaxy Tab Active3 LTE (SM-T575, SM-T575N), bring-up: not booted yet.
# Everything the variants share is in samsung-gtactive3-common; this
# package is the variant's identity: deviceinfo, the kernel command line
# and its DTB. The modem (the SoC's Shannon CP) has no driver yet
# (docs/re/modem.md in the port repository).
maintainer="dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>"
pkgname=device-samsung-gtactive3
pkgdesc="Samsung Galaxy Tab Active3 (LTE)"
pkgver=1
pkgrel=1
url="https://github.com/exynos-linux/samsung-gtactive3"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !tracedeps"
depends="
	$pkgname-initramfs=$pkgver-r$pkgrel
	samsung-gtactive3-common
	linux-postmarketos-exynos9810-gtactive3
	"
# podman for every user, with an Alpine image that works offline
_pmb_recommends="samsung-gtactive3-common-containers"
makedepends="devicepkg-dev"
# duranium-build's pmaports.py puts device-<codename>-initramfs into the
# initrd (pmos/duranium-build 0001): it brings the common early-boot
# support (USB prep, watchdog, nested GPT) there
subpackages="$pkgname-initramfs:initramfs"
source="
	deviceinfo
	kernel-cmdline.conf
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

initramfs() {
	pkgdesc="$pkgdesc (initrd and early boot support)"
	depends="samsung-gtactive3-common-initramfs"
	mkdir -p "$subpkgdir"
}

sha512sums="

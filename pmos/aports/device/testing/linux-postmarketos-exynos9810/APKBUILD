# Kernel config: the gtactive3-mainline bring-up config the device runs
# (configs/gtactive3-bringup.config), plus the pmbootstrap kconfigcheck
# categories below and the device fragment for systemd, Duranium (UKI,
# dm-verity, nested GPT) and the USB debug layer. Generated by
# contrib/samsung-gtactive3wifi/kernel/gen-kernel-config.sh in the
# gtactive3-mainline Duranium build tree; regenerate after rebasing.
#
# Patches: the gtactive3wifi branch of the gtactive3-mainline src/linux
# (091acc188, kernel r25), linearised (its merge commits replayed in order),
# plus patches/linux/0153 (the board DT split into a common file and one
# file per Galaxy Tab Active3 variant) and 0154 (the Shannon CP remoteproc
# sketch, not enabled); the patched tree is _commit.
maintainer="dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>"
pkgname=linux-postmarketos-exynos9810
pkgver=7.3.0_git20261021
pkgrel=26
_commit="12b04826f307d1635aa6e1eff7ca55fb62ab4f97"
# torvalds/linux commit that gtactive3.patch applies to; base + patch
# is the tree of _commit in the gtactive3-mainline kernel (scripts/pmos-export)
_base="f47d223627f80cb7a1eb14c585fe6cb35de5e984"
pkgdesc="Mainline kernel for Samsung Exynos 9810 devices (WIP)"
url="https://github.com/exynos-linux/samsung-gtactive3wifi"
arch="aarch64"
_carch="arm64"
_flavor="${pkgname#linux-}"
license="GPL-2.0-only"
# All pmb:kconfigcheck-community categories except "hardening", whose CFI
# needs clang; the config is generated and build-tested with GCC.
options="!check !strip !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-accessibility
	pmb:kconfigcheck-community_various
	pmb:kconfigcheck-containers
	pmb:kconfigcheck-debug
	pmb:kconfigcheck-filesystems
	pmb:kconfigcheck-immutable
	pmb:kconfigcheck-input
	pmb:kconfigcheck-iwd
	pmb:kconfigcheck-netboot
	pmb:kconfigcheck-netmount
	pmb:kconfigcheck-nftables
	pmb:kconfigcheck-usb
	pmb:kconfigcheck-usb_gadgets
	pmb:kconfigcheck-waydroid
	pmb:kconfigcheck-wine
	pmb:kconfigcheck-wireguard
	pmb:kconfigcheck-zram
	"
makedepends="
	bash
	bc
	bison
	elfutils-dev
	findutils
	flex
	gmp-dev
	linux-headers
	mpc1-dev
	mpfr-dev
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
	"

_config="config-$_flavor.$arch"
# One subpackage per Galaxy Tab Active3 variant with only its DTB: each
# device package depends on its own, so each image's UKI gets one
# unconditional .dtb section (Duranium's mkosi embeds every DTB under
# /boot/dtbs, as .dtbauto sections matched against U-Boot's DT when there
# are several). config.toml variants.<codename>.kernel_dtb_package; listed
# literally, as pmbootstrap's APKBUILD parser does not run shell loops.
subpackages="
	$pkgname-gtactive3wifi:_dtb
	$pkgname-gtactive3:_dtb
	"
source="
	linux-$_base.tar.gz::https://github.com/torvalds/linux/archive/$_base.tar.gz
	gtactive3.patch
	$_config
	"
builddir="$srcdir/linux-$_base"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	# "make install" installs the uncompressed Image as /boot/vmlinuz,
	# which uniLoader needs (it reads the PE header to find the DTB)
	make install modules_install \
		ARCH="$_carch" \
		CC="${CC:-gcc}" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr

	# no DTB here: the per-variant subpackages (_dtb) carry them

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

_dtb() {
	local _v=${subpkgname#"$pkgname"-}
	pkgdesc="$pkgdesc: device tree of samsung-$_v"
	depends="$pkgname=$pkgver-r$pkgrel"
	install -Dm644 "$builddir"/arch/$_carch/boot/dts/exynos/exynos9810-$_v.dtb \
		"$subpkgdir"/boot/dtbs/exynos/exynos9810-$_v.dtb
}

sha512sums="

+++ b/drivers/remoteproc/Kconfig
@@ -324,6 +324,17 @@ config ST_REMOTEPROC
 config ST_SLIM_REMOTEPROC
 	tristate
 
+config SAMSUNG_SHANNON_CP
+	tristate "Samsung Shannon CP (Exynos 9810 modem) remoteproc (sketch)"
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	depends on HAVE_ARM_SMCCC

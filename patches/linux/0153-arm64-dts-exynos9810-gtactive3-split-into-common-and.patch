--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3-common.dtsi
@@ -0,0 +1,2213 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Galaxy Tab Active3 family (Exynos 9810): what every variant
+ * shares. The Wi-Fi SM-T570 (gtactive3wifi) and the LTE SM-T575/T575N
+ * (gtactive3) are one board design; the LTE one adds the SoC's modem
+ * (docs/VARIANTS.md in the port repository). Board files:
+ * exynos9810-gtactive3wifi.dts and exynos9810-gtactive3.dts.
+ *
+ * Based on exynos9810-starlte.dts:
+ * Copyright (c) 2024 Markuss Broks <markuss.broks@gmail.com>
+ * Copyright (c) 2024 Maksym Holovach <nergzd@nergzd723.xyz>
+ *
+ * Framebuffer base and key GPIOs are taken from the stock T570XXSFEYI1 DTBO
+ * (hw_rev 5+); the T575's stock tree has the same framebuffer carveout.
+ * TODO: the memory map is still copied from starlte and must be checked
+ * against /proc/iomem on the device.
+ */
+
+#include "exynos9810.dtsi"
+#include <dt-bindings/clock/samsung,exynos9810-acpm.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/gpio-keys.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	/* model and compatible: the board files */
+	chassis-type = "tablet";
+
+	/*
+	 * EB-BT575BBE, values from the stock sec-battery node (DTBO hw_rev 4):
+	 * battery_full_capacity 5000 mAh, chg_float_voltage 4260 mV,
+	 * max_charging_current 3100 mA, sw_v_empty_voltage 3200 mV.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <5000000>;
+		constant-charge-current-max-microamp = <3100000>;
+		constant-charge-voltage-max-microvolt = <4260000>;
+		voltage-max-design-microvolt = <4260000>;
+		voltage-min-design-microvolt = <3200000>;
+	};
+
+	/*
+	 * 32.768 kHz RTC clock (XrtcXTI) from the S2MPS18, always on; the
+	 * PMIC is read-only here, so it is not modelled as a PMIC clock.
+	 */
+	rtcclk: clock-rtcclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+		clock-output-names = "rtcclk";
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Scanned out by DECON_F window 5 in video mode, dual DSI
+		 * (2 x 600x1920). The window blends with PD_FUNC_COPY, so the
+		 * alpha byte is ignored and XRGB8888 needs no conversion.
+		 */
+		framebuffer0: framebuffer-0 {
+			compatible = "simple-framebuffer";
+			memory-region = <&fb_mem>;
+			width = <1200>;
+			height = <1920>;
+			stride = <(1200 * 4)>;
+			format = "x8r8g8b8";
+			panel = <&panel>;
+		};
+	};
+
+	/*
+	 * Himax HX83102E (BOE) TDDI, 1200x1920 portrait, on DSIM0 + DSIM1.
+	 * There is no DSI host driver yet: the bootloader initialises the
+	 * panel and this node only describes it for simpledrm (physical size,
+	 * mounting) and links the DCS backlight. Change "rotation" here if
+	 * userspace should treat another edge as the top.
+	 *
+	 * The node is disabled on purpose: "panel" is a fw_devlink supplier
+	 * property, and an enabled node that never becomes a device would
+	 * keep simpledrm in deferred probe forever ("wait for supplier
+	 * /panel"; this config has no deferred probe timeout). simpledrm
+	 * reads width-mm/height-mm/rotation regardless of the status.
+	 */
+	panel: panel {
+		status = "disabled";
+		width-mm = <108>;
+		height-mm = <172>;
+		rotation = <0>;
+		backlight = <&backlight>;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&key_power &key_voldown &key_volup &key_home &key_hot
+			     &key_back &key_recent &hall_irq>;
+		pinctrl-names = "default";
+
+		power-key {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa2 4 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+
+		voldown-key {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa0 4 GPIO_ACTIVE_LOW>;
+		};
+
+		volup-key {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;
+		};
+
+		home-key {
+			label = "Home";
+			linux,code = <KEY_HOMEPAGE>;
+			gpios = <&gpa3 5 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+
+		/* "Active key" on the side, user-programmable in stock firmware */
+		hot-key {
+			label = "Active";
+			linux,code = <KEY_PROG1>;
+			gpios = <&gpa0 5 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+
+		back-key {
+			label = "Back";
+			linux,code = <KEY_BACK>;
+			gpios = <&gpg3 0 GPIO_ACTIVE_LOW>;
+		};
+
+		recent-key {
+			label = "Recent apps";
+			/* KEY_APPSELECT (580) is beyond XKB keymaps: use the "expose" key */
+			linux,code = <KEY_SCALE>;
+			gpios = <&gpg3 1 GPIO_ACTIVE_LOW>;
+		};
+
+		/*
+		 * Book cover hall sensor, low while the cover is closed
+		 * (stock "hall" node: hall,gpio_flip_cover = gpa0-2; Samsung
+		 * hall.c reports !gpio_get_value() as the closed state).
+		 */
+		hall-sensor {
+			label = "Cover";
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			gpios = <&gpa0 2 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			wakeup-source;
+			/* wake when the cover opens, not when it closes */
+			wakeup-event-action = <EV_ACT_DEASSERTED>;
+		};
+	};
+
+	/* Coin DC motor, switched by the motor LDO enable (stock dc_vibrator) */
+	vibrator {
+		compatible = "gpio-vibrator";
+		enable-gpios = <&gpg3 6 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&mot_ldo_en>;
+		pinctrl-names = "default";
+	};
+
+	/*
+	 * Rear camera flash: RT8547, FLEN = gpg3-5, CTRL = gpg0-7 (stock
+	 * leds_rt8547: flash_en/flash_control). Stock currents: flash 1000 mA,
+	 * movie (torch) 150 mA.
+	 */
+	led-controller {
+		compatible = "richtek,rt8547";
+		flen-gpios = <&gpg3 5 GPIO_ACTIVE_HIGH>;
+		ctrl-gpios = <&gpg0 7 GPIO_ACTIVE_HIGH>;
+
+		led {
+			function = LED_FUNCTION_FLASH;
+			color = <LED_COLOR_ID_WHITE>;
+			flash-max-timeout-us = <512000>;
+			flash-max-microamp = <1000000>;
+			led-max-microamp = <150000>;
+		};
+	};
+
+	/* S Pen digitiser supply (stock wacom_ldo_en: gpm42-0, 3.3 V) */
+	vdd_wacom: regulator-wacom {
+		compatible = "regulator-fixed";
+		regulator-name = "wacom_3.3v";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpm42 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	/*
+	 * The AP ADC samples the NTCs ratiometrically; its reference is not
+	 * described in the stock DT and is assumed to be 1.8 V here. The
+	 * lookup tables below are the stock sec-battery ADC code tables
+	 * (DTBO hw_rev 4) converted to mV with the same 1.8 V, so only the
+	 * ratio matters.
+	 */
+	vref_adc: regulator-adc-vref {
+		compatible = "regulator-fixed";
+		regulator-name = "adc_vref";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	/* Battery pack NTC (stock adc-temp, thermal_source ADC) */
+	batt_ntc: thermal-sensor-battery {
+		compatible = "generic-adc-thermal";
+		#thermal-sensor-cells = <0>;
+		io-channels = <&adc 1>;
+		io-channel-names = "sensor-channel";
+		temperature-lookup-table = <
+			(-20000) 1603 (-19000) 1594 (-18000) 1585 (-17000) 1576
+			(-16000) 1567 (-15000) 1558 (-14000) 1546 (-13000) 1535
+			(-12000) 1523 (-11000) 1512 (-10000) 1500 (-9000) 1487
+			(-8000) 1472 (-7000) 1458 (-6000) 1444 (-5000) 1432
+			(-4000) 1419 (-3000) 1406 (-2000) 1393 (-1000) 1375
+			0 1358 1000 1340 2000 1320 3000 1302
+			4000 1284 5000 1267 6000 1248 7000 1230
+			8000 1212 9000 1194 10000 1175 11000 1156
+			12000 1136 13000 1116 14000 1097 15000 1077
+			16000 1056 17000 1036 18000 1015 19000 995
+			20000 974 21000 955 22000 935 23000 916
+			24000 896 25000 876 26000 855 27000 839
+			28000 826 29000 813 30000 800 31000 786
+			32000 773 33000 760 34000 747 35000 725
+			36000 703 37000 659 38000 625 39000 608
+			40000 590 41000 574 42000 559 43000 543
+			44000 527 45000 511 46000 497 47000 483
+			48000 474 49000 465 50000 457 51000 448
+			52000 439 53000 420 54000 403 55000 385
+			56000 367 57000 357 58000 346 59000 335
+			60000 324 61000 316 62000 309 63000 301
+			64000 293 65000 286 66000 278 67000 270
+			68000 263 69000 255 70000 247 71000 240
+			72000 233 73000 226 74000 219 75000 212
+			76000 206 77000 200 78000 194 79000 188
+			80000 182 81000 178 82000 173 83000 169
+			84000 164 85000 160 86000 156 87000 151
+			88000 147 89000 142 90000 138
+		>;
+	};
+
+	/* NTC next to the MAX77705 charger (stock adc-chg-temp) */
+	chg_ntc: thermal-sensor-charger {
+		compatible = "generic-adc-thermal";
+		#thermal-sensor-cells = <0>;
+		io-channels = <&adc 3>;
+		io-channel-names = "sensor-channel";
+		temperature-lookup-table = <
+			(-20000) 1598 (-19000) 1589 (-18000) 1579 (-17000) 1570
+			(-16000) 1560 (-15000) 1551 (-14000) 1539 (-13000) 1527
+			(-12000) 1516 (-11000) 1504 (-10000) 1492 (-9000) 1478
+			(-8000) 1464 (-7000) 1449 (-6000) 1435 (-5000) 1421
+			(-4000) 1406 (-3000) 1390 (-2000) 1375 (-1000) 1360
+			0 1345 1000 1327 2000 1309 3000 1290
+			4000 1272 5000 1254 6000 1236 7000 1218
+			8000 1200 9000 1181 10000 1163 11000 1143
+			12000 1123 13000 1103 14000 1083 15000 1063
+			16000 1043 17000 1022 18000 1001 19000 981
+			20000 960 21000 941 22000 922 23000 902
+			24000 883 25000 864 26000 843 27000 821
+			28000 800 29000 778 30000 757 31000 739
+			32000 721 33000 703 34000 685 35000 667
+			36000 650 37000 632 38000 614 39000 596
+			40000 578 41000 562 42000 545 43000 528
+			44000 512 45000 495 46000 482 47000 469
+			48000 457 49000 444 50000 431 51000 419
+			52000 407 53000 394 54000 382 55000 369
+			56000 359 57000 348 58000 338 59000 327
+			60000 316 61000 309 62000 301 63000 294
+			64000 286 65000 278 66000 271 67000 263
+			68000 255 69000 248 70000 240 71000 234
+			72000 227 73000 220 74000 213 75000 207
+			76000 200 77000 194 78000 188 79000 182
+			80000 176 81000 172 82000 167 83000 163
+			84000 159 85000 154 86000 150 87000 145
+			88000 141 89000 137 90000 132
+		>;
+	};
+
+	/* NTC at the USB-C connector (stock adc-usb-temp) */
+	usb_ntc: thermal-sensor-usb {
+		compatible = "generic-adc-thermal";
+		#thermal-sensor-cells = <0>;
+		io-channels = <&adc 4>;
+		io-channel-names = "sensor-channel";
+		temperature-lookup-table = <
+			(-20000) 1603 (-19000) 1594 (-18000) 1585 (-17000) 1576
+			(-16000) 1567 (-15000) 1557 (-14000) 1546 (-13000) 1534
+			(-12000) 1523 (-11000) 1512 (-10000) 1501 (-9000) 1487
+			(-8000) 1472 (-7000) 1458 (-6000) 1444 (-5000) 1430
+			(-4000) 1415 (-3000) 1400 (-2000) 1385 (-1000) 1370
+			0 1356 1000 1338 2000 1320 3000 1302
+			4000 1284 5000 1266 6000 1248 7000 1230
+			8000 1212 9000 1193 10000 1175 11000 1156
+			12000 1136 13000 1116 14000 1096 15000 1076
+			16000 1056 17000 1036 18000 1015 19000 994
+			20000 974 21000 954 22000 934 23000 915
+			24000 895 25000 876 26000 854 27000 833
+			28000 812 29000 791 30000 769 31000 751
+			32000 733 33000 714 34000 696 35000 678
+			36000 660 37000 642 38000 625 39000 607
+			40000 589 41000 574 42000 558 43000 541
+			44000 526 45000 510 46000 496 47000 482
+			48000 468 49000 453 50000 439 51000 427
+			52000 414 53000 402 54000 390 55000 378
+			56000 367 57000 356 58000 345 59000 334
+			60000 323 61000 316 62000 308 63000 300
+			64000 292 65000 285 66000 277 67000 269
+			68000 261 69000 254 70000 247 71000 240
+			72000 232 73000 225 74000 218 75000 211
+			76000 205 77000 199 78000 193 79000 187
+			80000 181 81000 177 82000 172 83000 168
+			84000 163 85000 159 86000 155 87000 150
+			88000 146 89000 141 90000 137
+		>;
+	};
+
+	/*
+	 * No trips: the MAX77705 charger driver reads battery-thermal and
+	 * charger-thermal itself and throttles or stops charging at the stock
+	 * thresholds.
+	 */
+	thermal-zones {
+		battery-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&batt_ntc>;
+		};
+
+		charger-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&chg_ntc>;
+		};
+
+		usb-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&usb_ntc>;
+		};
+	};
+
+	/*
+	 * Stock routing (dtbo-4.dts sound node, samsung,routing): headset mic
+	 * on IN1 with MICBIAS1, main mic on IN3 with MICBIAS2, sub mic on IN4
+	 * with MICBIAS3, headphones on HPOL/HPOR, speaker on the RT5510.
+	 */
+	sound {
+		compatible = "samsung,gtactive3-audio";
+		model = "Galaxy Tab Active3";
+		audio-routing = "Headphones", "HPOL",
+				"Headphones", "HPOR",
+				"Speaker", "OUTP",
+				"Speaker", "OUTN",
+				"IN1P", "Headset Mic",
+				"IN1N", "Headset Mic",
+				"Headset Mic", "MICBIAS1",
+				"IN3P", "Main Mic",
+				"IN3N", "Main Mic",
+				"Main Mic", "MICBIAS2",
+				"IN4P", "Sub Mic",
+				"IN4N", "Sub Mic",
+				"Sub Mic", "MICBIAS3";
+
+		headset-dai-link {
+			cpu {
+				sound-dai = <&abox 0>;
+			};
+			codec {
+				sound-dai = <&rt5665 0>;
+			};
+		};
+
+		speaker-dai-link {
+			cpu {
+				sound-dai = <&abox 1>;
+			};
+			codec {
+				sound-dai = <&rt5510>;
+			};
+		};
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3c800000>,
+		      <0x0 0xc0000000 0x20000000>,
+		      <0x0 0xe1900000 0x1e700000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		fb_mem: framebuffer@ca000000 {
+			reg = <0x0 0xca000000 (1200 * 1920 * 4)>;
+			no-map;
+		};
+
+		/* bring-up: keep the previous boot's kernel log across resets */
+		ramoops@8ff000000 {
+			compatible = "ramoops";
+			reg = <0x8 0xff000000 0x100000>;
+			console-size = <0x80000>;
+			record-size = <0x20000>;
+			pmsg-size = <0x10000>;
+		};
+
+		/* bring-up: U-Boot's console log (CONFIG_EXYNOS_MOBILE_RAMLOG) */
+		uboot-log@8ff100000 {
+			reg = <0x8 0xff100000 0x100000>;
+			no-map;
+		};
+	};
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+&rtc {
+	clocks = <&cmu_apm CLK_GOUT_APM_APBIF_RTC_PCLK>, <&rtcclk>;
+	clock-names = "rtc", "rtc_src";
+	status = "okay";
+};
+
+&abox {
+	pinctrl-0 = <&aud_i2s0_bus &aud_i2s1_bus>;
+	pinctrl-names = "default";
+	/* no CMU_AUD clock driver yet: let the A-Box driver set PLL_AUD up */
+	samsung,cmu-bringup;
+	status = "okay";
+};
+
+&adc {
+	vdd-supply = <&vref_adc>;
+	status = "okay";
+};
+
+&pinctrl_alive {
+	/* RT5665 GPIO1 = IRQ (jack detection, headset buttons) */
+	rt5665_irq: rt5665-irq-pins {
+		samsung,pins = "gpa2-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	key_power: key-power-pins {
+		samsung,pins = "gpa2-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa0-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_home: key-home-pins {
+		samsung,pins = "gpa3-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_hot: key-hot-pins {
+		samsung,pins = "gpa0-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	hall_irq: hall-irq-pins {

+
+&pmu_system_controller {
+	/* Boot reason for S-Boot, values from Samsung's sec_reboot.c */
+	reboot-mode {
+		compatible = "syscon-reboot-mode";
+		offset = <0x080c>; /* INFORM3 */
+		mode-normal = <0x12345670>;
+		mode-download = <0x12345671>;
+		mode-recovery = <0x12345674>;
+		mode-bootloader = <0x1234567d>;
+	};
+};
+
+&soc {
+	/*
+	 * USB 2.0 device mode. There is no Exynos9810 clock driver yet: the
+	 * bootloader leaves CMU_FSYS0 running (UFS lives there too) and init
+	 * forces the two USB gates on before loading these drivers, so the
+	 * 26 MHz oscillator stands in for every clock here.
+	 */
+	usbdrd: usb@10c00000 {
+		compatible = "samsung,exynos9810-dwusb3", "samsung,exynos850-dwusb3";
+		ranges = <0x0 0x10c00000 0x10000>;
+		clocks = <&oscclk>, <&oscclk>;
+		clock-names = "bus_early", "ref";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		usbdrd_dwc3: usb@0 {
+			compatible = "snps,dwc3";
+			reg = <0x0 0x10000>;
+			interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&usbdrd_phy 0>;
+			phy-names = "usb2-phy";
+			dr_mode = "peripheral";
+			maximum-speed = "high-speed";
+		};
+	};
+
+	usbdrd_phy: phy@11100000 {
+		compatible = "samsung,exynos9810-usbdrd-phy";
+		reg = <0x11100000 0x200>;
+		clocks = <&oscclk>, <&oscclk>;
+		clock-names = "phy", "ref";
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		#phy-cells = <1>;
+	};
+};
+
+&gpg3 {
+	/* USB D+/D- mux: low = USB-C port, high = pogo connector */
+	usb-mux-sel-hog {
+		gpio-hog;
+		gpios = <2 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "usb-mux-sel";
+	};
+};
+
+/ {
+	/*
+	 * USI / HSI2C clocks as programmed by the bootloader (no clock driver
+	 * yet). PLL_SHARED2 = 26 MHz * 400 / 13 = 800 MHz; CLKCMU_CMGP_BUS,
+	 * CLKCMU_PERIC0_IP and CLKCMU_PERIC1_IP = PLL_SHARED2 / 2 / 2 = 200 MHz.
+	 * USI_CMGP00/03, PERIC0/1 USI_I2C and I2C_CAM0-3 are undivided from
+	 * those (200 MHz), PERIC1 USI07/08_USI are divided by 4 (50 MHz).
+	 * The bus clocks are only gated, their rate does not matter.
+	 */
+	clk_usi_200m: clock-usi-200m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+		clock-output-names = "usi_200m";
+	};
+
+	clk_usi_50m: clock-usi-50m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+		clock-output-names = "usi_50m";
+	};
+
+	aliases {
+		/* the debug console's i2cr/i2cw use /dev/i2c-0 */
+		i2c0 = &hsi2c_40;
+		bluetooth0 = &bluetooth;
+		wifi0 = &wifi;
+		/* same numbers as the stock kernel: rt5665 3-001b, rt5510 4-0034 */
+		i2c3 = &hsi2c_7;
+		i2c4 = &hsi2c_18;
+		/* touchscreen stays spi0.0, sensor hub spi1.0 */
+		spi0 = &spi_21;
+		spi1 = &spi_20;
+	};
+};
+
+/* Camera I2C: S5K3L6 rear sensor @2d */
+&hsi2c_0 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * Power sequence of the stock module (fimc-is-device-module-3l6):
+	 * reset low, IO 1.8 V, analogue 2.8 V, core 1.05 V, AF 2.8 V, reset
+	 * high, then the 26 MHz CIS_CLK0 on gpc1-4.
+	 */
+	rear_camera: camera@2d {
+		compatible = "samsung,s5k3l6";
+		reg = <0x2d>;
+		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
+		pinctrl-0 = <&cam0_mclk>;
+		pinctrl-names = "default";
+		reset-gpios = <&gpg2 6 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&s2mps18_ldo44>;
+		vdda-supply = <&s2mps18_ldo32>;
+		vddd-supply = <&s2mps18_ldo34>;
+		afvdd-supply = <&s2mps18_ldo45>;
+		lens-focus = <&rear_lens>;
+		orientation = <1>;	/* back */
+		/* measured: upright in portrait (Snapshot on Phosh) */
+		rotation = <270>;
+
+		port {
+			rear_camera_out: endpoint {
+				remote-endpoint = <&csis0_in>;
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <598000000>;
+			};
+		};
+	};
+};
+
+&csis0 {
+	status = "okay";
+
+	port {
+		csis0_in: endpoint {
+			remote-endpoint = <&rear_camera_out>;
+			data-lanes = <1 2 3 4>;
+		};
+	};
+};
+
+/* Camera I2C: GC5035 front sensor @37 */
+&hsi2c_1 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * Stock power sequence (fimc-is-device-module-gc5035): reset low,
+	 * IO 1.8 V, core 1.2 V, analogue 2.8 V, reset high, then the 26 MHz
+	 * CIS_CLK1 on gpc1-5.
+	 */
+	front_camera: camera@37 {
+		compatible = "galaxycore,gc5035";
+		reg = <0x37>;
+		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK1>;
+		pinctrl-0 = <&cam1_mclk>;
+		pinctrl-names = "default";
+		reset-gpios = <&gpg2 5 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&s2mps18_ldo44>;
+		vddd-supply = <&s2mps18_ldo39>;
+		vdda-supply = <&s2mps18_ldo28>;
+		orientation = <0>;	/* front */
+		/* measured: upright in portrait (Snapshot on Phosh) */
+		rotation = <90>;
+
+		port {
+			front_camera_out: endpoint {
+				remote-endpoint = <&csis2_in>;
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <448500000 224000000>;
+			};
+		};
+	};
+};
+
+&csis2 {
+	status = "okay";
+
+	port {
+		csis2_in: endpoint {
+			remote-endpoint = <&front_camera_out>;
+			data-lanes = <1 2>;
+		};
+	};
+};
+
+/* Camera I2C: unused */
+&hsi2c_2 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";
+};
+
+/* Camera I2C: DW9808 actuator @0c, rear camera EEPROM @58 */
+&hsi2c_3 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/* rear camera autofocus voice coil (stock fimc-is-actuator-dw9808) */
+	rear_lens: lens@c {
+		compatible = "dongwoon,dw9808-vcm", "dongwoon,dw9807-vcm";
+		reg = <0x0c>;
+		vdd-supply = <&s2mps18_ldo45>;
+		vio-supply = <&s2mps18_ldo44>;
+		nvmem-cells = <&rear_af_pan>;
+		nvmem-cell-names = "af-pan";
+	};
+
+	/*
+	 * Rear camera module EEPROM, 16 KiB (stock rear_eeprom@58): AF
+	 * infinity/macro DAC codes and AWB calibration, read-only. Its supply
+	 * is the AF rail: stock's READ_ROM sequence (fimc-is-device-module-
+	 * 3l6.c) turns on VDD_RCAM_AF_2P8, then VDD_CAM_IO_1P8 for the bus
+	 * (always on here). Without the AF rail it never answers.
+	 */
+	eeprom@58 {
+		compatible = "atmel,24c128";
+		reg = <0x58>;
+		vcc-supply = <&s2mps18_ldo45>;
+		read-only;
+
+		nvmem-layout {
+			compatible = "fixed-layout";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* stock rom_af_cal_pan_addr: pan focus DAC code, s32 */
+			rear_af_pan: af-pan@3314 {
+				reg = <0x3314 0x4>;
+			};
+		};
+	};
+};
+
+/* RT5665 audio codec @1b */
+&usi01_i2c {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "pclk", "ipclk";
+	status = "okay";
+};
+
+&hsi2c_7 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";
+	status = "okay";
+
+	/*
+	 * Jack detection as in the stock dtbo-4: JD1 + JD2 (realtek,jd-src
+	 * = <2>), the codec's GPIO1 interrupt output on gpa2-2.
+	 * Supplies (stock realtek,regulator_1v8/_3v3): S2MPS18 LDO33 (1.8 V)
+	 * is on from boot and stays as S-Boot left it. LDO36 (3.3 V, for the
+	 * microphone bias; the codec is its only consumer in the stock DT) is
+	 * off at boot: the codec switches it, as the stock driver does.
+	 */
+	rt5665: audio-codec@1b {
+		compatible = "realtek,rt5665";
+		reg = <0x1b>;
+		#sound-dai-cells = <1>;
+		MICVDD-supply = <&s2mps18_ldo36>;
+		interrupt-parent = <&gpa2>;
+		interrupts = <2 IRQ_TYPE_EDGE_BOTH>;
+		pinctrl-0 = <&rt5665_irq>;
+		pinctrl-names = "default";
+		realtek,in1-differential;
+		realtek,in3-differential;
+		realtek,in4-differential;
+		realtek,jd-src = <2>;
+		/* the main mic path thumps for ~100 ms after power-up */
+		realtek,amic-delay-ms = <150>;
+	};
+};
+
+/* RT5510 speaker amplifier @34 (hw_rev 4) */
+&usi07_usi {
+	clocks = <&clk_usi_200m>, <&clk_usi_50m>;
+	clock-names = "pclk", "ipclk";
+	status = "okay";
+};
+
+&hsi2c_18 {
+	clocks = <&clk_usi_50m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/* hw_rev 4 only (dtbo-4); hw_rev 5+ has a TAS2562 here instead */
+	rt5510: amplifier@34 {
+		compatible = "richtek,rt5510";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
+	};
+};
+
+/* S.LSI NFC @27 */
+&usi08_usi {
+	clocks = <&clk_usi_200m>, <&clk_usi_50m>;
+	clock-names = "pclk", "ipclk";	status = "okay";
+};
+
+&hsi2c_20 {
+	clocks = <&clk_usi_50m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";	status = "okay";
+};
+
+/* Wacom W90xx S Pen digitiser @56 */
+&usi09_i2c {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "pclk", "ipclk";	status = "okay";
+};
+
+&hsi2c_23 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";	status = "okay";
+};
+
+/* A96T3X6 grip sensor @20 */
+&usi_cmgp00 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "pclk", "ipclk";	status = "okay";
+};
+
+&hsi2c_34 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";	status = "okay";
+};
+
+/* MAX77705 PMIC @66 (+ USB-C @25, fuel gauge @36, ...), SM5504 MUIC @14 */
+&usi_cmgp03 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "pclk", "ipclk";
+	status = "okay";
+};
+
+&hsi2c_40 {
+	clocks = <&clk_usi_200m>, <&clk_usi_200m>;
+	clock-names = "hsi2c", "hsi2c_pclk";
+	clock-frequency = <100000>;
+	status = "okay";
+};
+
+/ {
+	/*
+	 * UFS clocks as programmed by the bootloader (no clock driver yet):
+	 * PLL_SHARED4 = 26 MHz * 205 / 8 = 666.25 MHz;
+	 * FSYS0 bus = PLL_SHARED4 / 2, UFS_EMBD (UniPro) = PLL_SHARED4 / 2 / 2.
+	 */
+	ufs_core_clk: clock-ufs-core {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <333125000>;
+	};
+
+	ufs_unipro_clk: clock-ufs-unipro {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <166562500>;
+	};
+};
+
+&soc {
+	ufs_phy: phy@11124000 {
+		compatible = "samsung,exynos9810-ufs-phy";
+		reg = <0x11124000 0x800>;
+		reg-names = "phy-pma";
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		clocks = <&oscclk>;
+		clock-names = "ref_clk";
+		#phy-cells = <0>;
+	};
+
+	ufs: ufs@11120000 {
+		compatible = "samsung,exynos9810-ufs";
+		reg = <0x11120000 0x200>,
+		      <0x11121100 0x200>,
+		      <0x11110000 0x8000>,
+		      <0x11130000 0x100>;
+		reg-names = "hci", "vs_hci", "unipro", "ufsp";
+		interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&ufs_core_clk>, <&ufs_unipro_clk>;
+		clock-names = "core_clk", "sclk_unipro_main";
+		freq-table-hz = <0 0>, <0 0>;
+		phys = <&ufs_phy>;
+		phy-names = "ufs-phy";
+	};
+};
+
+/*
+ * Only the cluster 0 (A55) watchdog: the cluster 1 counter does not run while
+ * the M3 cores are off (WTCNT stays at WTDAT).
+ */
+/*
+ * microSD slot (stock dwmmc2, DTBO fragment@72): 4-bit, UHS-I up to
+ * SDR104, card detect on gpa1-5, card power LDO31 (2.95 V), signalling
+ * LDO2 (2.95 V, 1.8 V for UHS-I).
+ */
+&mmc_2 {
+	bus-width = <4>;
+	card-detect-delay = <200>;
+	cd-gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	vmmc-supply = <&s2mps18_ldo31>;
+	vqmmc-supply = <&s2mps18_ldo2>;
+	pinctrl-0 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4 &sd2_cd>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&watchdog_cl0 {
+	status = "okay";
+};
+
+&soc {
+	/*
+	 * The HX83102E takes its brightness as DCS 0x51 (12 bits, two bytes)
+	 * on both DSI links and drives the LED PWM itself; there is no
+	 * backlight IC on I2C. Samsung's table tops out at 2437 in normal
+	 * use and 3977 in outdoor mode, 928 is its default.
+	 */
+	backlight: backlight@16080000 {
+		compatible = "samsung,exynos9810-dsim-backlight";
+		reg = <0x16080000 0x100>, <0x16090000 0x100>;
+		max-brightness = <3977>;
+		default-brightness = <928>;
+		/* Night Light: the DPU gamma LUT in the panel's digital gamma */
+		samsung,hx83102e-dgc;
+		/*
+		 * Panel power (stock decon_board_hx83102e: gpio_lcd_rst,
+		 * gpio_ldo_en, gpio_buck_en), for power_off_level 3.
+		 */
+		reset-gpios = <&gpa3 4 GPIO_ACTIVE_LOW>;
+		ldo-enable-gpios = <&gpg2 2 GPIO_ACTIVE_HIGH>;
+		buck-enable-gpios = <&gph1 4 GPIO_ACTIVE_HIGH>;
+	};
+};

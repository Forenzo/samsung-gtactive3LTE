+	sensorhub@0 {
+		compatible = "brcm,bcm4775";
+		reg = <0>;
+		/* stock: 25 MHz, mode 3 */
+		spi-max-frequency = <12500000>;
+		spi-cpol;
+		spi-cpha;
+
+		interrupt-parent = <&gpa2>;
+		interrupts = <1 IRQ_TYPE_LEVEL_HIGH>;
+		host-req-gpios = <&gpa2 1 GPIO_ACTIVE_HIGH>;
+		mcu-req-gpios = <&gpp2 1 GPIO_ACTIVE_HIGH>;
+		mcu-resp-gpios = <&gpp2 0 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&gpg0 4 GPIO_ACTIVE_HIGH>;
+		ap-sleep-gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
+		vdd-mcu-supply = <&s2mps18_ldo37>;
+
+		pinctrl-0 = <&shub_host_req &shub_ap_sleep &shub_mcu_resp
+			     &shub_mcu_req &shub_nstdby>;
+		pinctrl-names = "default";
+
+		/*
+		 * The hub turns the accelerometer axes into Android's frame
+		 * of the portrait panel (x right, y up, z out of the screen;
+		 * +1 g along the axis pointing up). iio-sensor-proxy wants
+		 * the direction of gravity instead: -1 g on y when upright.
+		 */
+		mount-matrix = "-1", "0", "0",
+			       "0", "-1", "0",
+			       "0", "0", "1";
+

+/*
+ * S2MPS18 main PMIC, reached through ACPM IPC channel 2 (stock
+ * s2mps18mfd node, DTBO hw_rev 4). The driver is read-only for now, so
+ * the regulators carry no voltage constraints: the stock ranges are
+ * kept as comments for when voltage control is enabled. The PMIC IRQ is
+ * gpa0-1 (not used yet).
+ */
+&acpm_ipc {
+	pmic-1 {
+		compatible = "samsung,s2mps18-pmic";
+
+		regulators {
+			s2mps18_buck1: BUCK1 {
+				regulator-name = "vdd_mif";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_buck2: BUCK2 {
+				regulator-name = "vdd_cpucl1";
+				regulator-always-on;
+				/* stock: 450-1300 mV */
+			};
+
+			s2mps18_buck3: BUCK3 {
+				regulator-name = "vdd_cpucl0";
+				regulator-always-on;
+				/* stock: 450-1300 mV */
+			};
+
+			s2mps18_buck4: BUCK4 {
+				regulator-name = "vdd_int";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_buck5: BUCK5 {
+				regulator-name = "vdd_cam";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_buck6: BUCK6 {
+				regulator-name = "vdd_g3d";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_buck7: BUCK7 {
+				regulator-name = "vdd_cpucl1_m";
+				regulator-always-on;
+				/* stock: 450-1300 mV */
+			};
+
+			s2mps18_buck8: BUCK8 {
+				regulator-name = "vdd2_mem";
+				regulator-always-on;
+				/* stock: 900-1300 mV */
+			};
+
+			s2mps18_buck9: BUCK9 {
+				regulator-name = "vddq_mem";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_buck10: BUCK10 {
+				regulator-name = "vdd_lldo1";
+				regulator-always-on;
+				/* stock: 750-1150 mV */
+			};
+
+			s2mps18_buck11: BUCK11 {
+				regulator-name = "vdd_lldo2";
+				regulator-always-on;
+				/* stock: 900-1300 mV */
+			};
+
+			s2mps18_buck12: BUCK12 {
+				regulator-name = "vdd_lldo3";
+				regulator-always-on;
+				/* stock: 1100-1500 mV */
+			};
+
+			s2mps18_buck13: BUCK13 {
+				regulator-name = "vdd_mldo";
+				regulator-always-on;
+				/* stock: 1750-2150 mV */
+			};
+
+			s2mps18_ldo1: LDO1 {
+				regulator-name = "vdd_ldo1";
+				regulator-always-on;
+				/* stock: 700-950 mV */
+			};
+
+			s2mps18_ldo2: LDO2 {
+				regulator-name = "vqmmc";
+				/* stock: 1700-2950 mV, the LDO starts at 1800 mV */
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <2950000>;
+			};
+
+			s2mps18_ldo3: LDO3 {
+				regulator-name = "vdd_ldo3";
+				regulator-always-on;
+				/* stock: 1600-1950 mV */
+			};
+
+			s2mps18_ldo4: LDO4 {
+				regulator-name = "vdd_ldo4";
+				regulator-always-on;
+				/* stock: 700-1100 mV */
+			};
+
+			s2mps18_ldo5: LDO5 {
+				regulator-name = "vdd_ldo5";
+				regulator-always-on;
+				/* stock: 1600-1950 mV */
+			};
+
+			s2mps18_ldo6: LDO6 {
+				regulator-name = "vdd_ldo6";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_ldo7: LDO7 {
+				regulator-name = "vdd_ldo7";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_ldo8: LDO8 {
+				regulator-name = "vdd_ldo8";
+				regulator-always-on;
+				/* stock: 700-1300 mV */
+			};
+
+			s2mps18_ldo9: LDO9 {
+				regulator-name = "vdd_ldo9";
+				regulator-always-on;
+				/* stock: 1600-1950 mV */
+			};
+
+			s2mps18_ldo10: LDO10 {
+				regulator-name = "vdd_ldo10";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_ldo11: LDO11 {
+				regulator-name = "vdd_ldo11";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_ldo12: LDO12 {
+				regulator-name = "vdd_ldo12";
+				regulator-always-on;
+				/* stock: 700-1100 mV */
+			};
+
+			s2mps18_ldo13: LDO13 {
+				regulator-name = "vdd_ldo13";
+				regulator-always-on;
+				/* stock: 1600-1950 mV */
+			};
+
+			s2mps18_ldo14: LDO14 {
+				regulator-name = "vdd_ldo14";
+				regulator-always-on;
+				/* stock: 1700-3350 mV */
+			};
+
+			s2mps18_ldo22: LDO22 {
+				regulator-name = "vdd_ldo22";
+				/* stock: 700-1100 mV */
+			};
+
+			s2mps18_ldo28: LDO28 {
+				regulator-name = "VDD_FCAM_A2P8";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			s2mps18_ldo30: LDO30 {
+				regulator-name = "vdd_ldo30";
+				regulator-always-on;
+				/* stock: 450-1100 mV */
+			};
+
+			s2mps18_ldo31: LDO31 {
+				regulator-name = "vmmc";
+				regulator-min-microvolt = <2950000>;
+				regulator-max-microvolt = <2950000>;
+			};
+
+			s2mps18_ldo32: LDO32 {
+				regulator-name = "VDD_RCAM_A2P8";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			s2mps18_ldo33: LDO33 {
+				regulator-name = "regulator_1v8";
+				regulator-boot-on;
+				/* stock: 1800 mV */
+			};
+
+			s2mps18_ldo34: LDO34 {
+				regulator-name = "VDD_RCAM_CORE_1P05";
+				regulator-min-microvolt = <1050000>;
+				regulator-max-microvolt = <1050000>;
+			};
+
+			/*
+			 * LDO35/42/43: the sensors behind the BCM4775 hub (accel,
+			 * light/proximity and its IR LED, magnetometer). S-Boot
+			 * leaves them off; the hub finds no sensors without them.
+			 */
+			s2mps18_ldo35: LDO35 {
+				regulator-name = "VDD_SENSOR_1P8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+			};
+
+			/* RT5665 MICVDD: S-Boot leaves it off (LCTRL 0x3c) */
+			s2mps18_ldo36: LDO36 {
+				regulator-name = "regulator_3v3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+			};
+
+			s2mps18_ldo37: LDO37 {
+				regulator-name = "vdd_mcu_1p8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			s2mps18_ldo38: LDO38 {
+				regulator-name = "VDD_ESE_1P8";
+				/* stock: 1800 mV */
+			};
+
+			s2mps18_ldo39: LDO39 {
+				regulator-name = "VDD_FCAM_CORE_1P2";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+			};
+
+			s2mps18_ldo40: LDO40 {
+				regulator-name = "VDD_GRIP_3P0";
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
+			};
+
+			s2mps18_ldo41: LDO41 {
+				regulator-name = "VDD_NFC_1P8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			s2mps18_ldo42: LDO42 {
+				regulator-name = "vdd_proxy_led_3p3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+
+			s2mps18_ldo43: LDO43 {
+				regulator-name = "vdd_ldo43";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+
+			s2mps18_ldo44: LDO44 {
+				regulator-name = "VDD_CAM_IO_1P8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			s2mps18_ldo45: LDO45 {
+				regulator-name = "VDD_RCAM_AF_2P8";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+		};
+	};
+};

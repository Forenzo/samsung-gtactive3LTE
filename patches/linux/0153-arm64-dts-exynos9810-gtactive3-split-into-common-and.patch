-	status = "okay";
-
-	/*
-	 * Jack detection as in the stock dtbo-4: JD1 + JD2 (realtek,jd-src
-	 * = <2>), the codec's GPIO1 interrupt output on gpa2-2.
-	 * Supplies (stock realtek,regulator_1v8/_3v3): S2MPS18 LDO33 (1.8 V)
-	 * is on from boot and stays as S-Boot left it. LDO36 (3.3 V, for the
-	 * microphone bias; the codec is its only consumer in the stock DT) is
-	 * off at boot: the codec switches it, as the stock driver does.
-	 */
-	rt5665: audio-codec@1b {
-		compatible = "realtek,rt5665";
-		reg = <0x1b>;
-		#sound-dai-cells = <1>;
-		MICVDD-supply = <&s2mps18_ldo36>;
-		interrupt-parent = <&gpa2>;
-		interrupts = <2 IRQ_TYPE_EDGE_BOTH>;
-		pinctrl-0 = <&rt5665_irq>;
-		pinctrl-names = "default";
-		realtek,in1-differential;
-		realtek,in3-differential;
-		realtek,in4-differential;
-		realtek,jd-src = <2>;
-		/* the main mic path thumps for ~100 ms after power-up */
-		realtek,amic-delay-ms = <150>;
-	};

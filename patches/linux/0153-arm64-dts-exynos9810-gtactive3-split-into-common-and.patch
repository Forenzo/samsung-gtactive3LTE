+/*
+ * CPU DVFS through the APM firmware (ACPM DVFS, channel 0). Levels from its
+ * fvmap in APM SRAM (domain 2: A55 208-2002 MHz, domain 3: M3 598-2886 MHz);
+ * the firmware sets the voltages. A55 capped at its retail 1.95 GHz. The
+ * SM-T570 stock kernel limits the M3 cluster to 650-1794 MHz (cpufreq
+ * domain@1 max-freq/policy-max); the levels above that up to the S9's
+ * 2.7 GHz are kept as boost (turbo-mode) OPPs, off unless
+ * /sys/devices/system/cpu/cpufreq/boost is set.
+ *
+ * opp-microwatt (Energy Model for EAS) per core from the stock DT
+ * energy-costs (core busy cost + a quarter of the cluster cost, in mW,
+ * x1000); the A55 208/299 MHz levels, which stock does not use, are
+ * extrapolated linearly from 455 MHz.
+ */
+/ {
+	cluster0_opp: opp-table-cluster0-opp {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-208000000 {
+			opp-hz = /bits/ 64 <208000000>;
+			clock-latency-ns = <100000>;
+			opp-microwatt = <10000>;
+		};
+
+		opp-299000000 {
+			opp-hz = /bits/ 64 <299000000>;
+			clock-latency-ns = <100000>;
+			opp-microwatt = <14600>;
+		};
+
+		opp-455000000 {
+			opp-hz = /bits/ 64 <455000000>;
+			clock-latency-ns = <100000>;
+			opp-microwatt = <22250>;
+		};
+
+		opp-598000000 {
+			opp-hz = /bits/ 64 <598000000>;
+			clock-latency-ns = <100000>;
+			opp-microwatt = <31750>;
+		};
+
+		opp-715000000 {
+			opp-hz = /bits/ 64 <715000000>;
+			clock-latency-ns = <100000>;
+			opp-microwatt = <40000>;
+		};
+
+		opp-832000000 {
+			opp-hz = /bits/ 64 <832000000>;
+			clock-latency-ns = <100000>;
+			opp-microwatt = <52750>;
+		};
+
+		opp-949000000 {

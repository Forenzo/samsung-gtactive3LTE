@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Galaxy Tab Active3 LTE (gtactive3/SM-T575, SM-T575N) device tree
+ * source
+ *
+ * The same board as the Wi-Fi SM-T570 (exynos9810-gtactive3-common.dtsi)
+ * plus the Exynos 9810's own LTE modem (Shannon CP). Bring-up state: not
+ * yet booted on a T575. What differs, from the stock T575XXSFEYI1 device
+ * tree of a hw_rev 5 unit (docs/VARIANTS.md in the port repository):
+ *
+ *  - /reserved-memory/modem_if (0xf0000000, 146 MiB, "exynos,modem_if")
+ *    and cp_ram_logging (0xf9200000, 32 MiB): the CP's shared memory and
+ *    log buffer. Kept away from Linux until there is a modem driver, so
+ *    nothing of ours lands where the CP (or a later driver) expects them.
+ *  - The speaker amplifier on hw_rev 5 boards is a TI TAS2562 at 0x4c on
+ *    HSI2C 18 instead of the RT5510 at 0x34. This depends on the board
+ *    revision, not on the model (a hw_rev 5 SM-T570 has it too), so it
+ *    moves to the common file once the revision is known at boot.
+ *
+ * The first compatible must stay "samsung,gtactive3": systemd-stub matches
+ * it against U-Boot's device tree to pick this DTB from the UKI.
+ */
+
+/dts-v1/;
+#include "exynos9810-gtactive3-common.dtsi"
+
+/ {
+	model = "Samsung Galaxy Tab Active3 LTE (SM-T575)";
+	compatible = "samsung,gtactive3", "samsung,exynos9810";
+
+	reserved-memory {
+		/*
+		 * Modem shared memory: CP firmware image, IPC rings and the
+		 * CP's own RAM. Stock: modem_if (compatible "exynos,modem_if").
+		 * A future driver takes it over as its memory-region.
+		 */
+		cp_shmem: modem@f0000000 {
+			reg = <0x0 0xf0000000 0x09200000>;
+			no-map;
+		};
+
+		/* Stock cp_ram_logging: the CP's trace buffer, right after it */
+		cp_log: modem-log@f9200000 {
+			reg = <0x0 0xf9200000 0x02000000>;
+			no-map;
+		};
+	};
+};
+
+/*
+ * The same BCM4375 module as the Wi-Fi variant: brcmfmac names its firmware
+ * after the board type (brcmfmac4375b1-pcie.<board>.{bin,txt,clm_blob}),
+ * which defaults to the root compatible. Keep the Wi-Fi variant's names so
+ * the installer's firmware import (the owner's own stock files) serves
+ * both. Bluetooth (btbcm) has no such override and looks for
+ * BCM.samsung,gtactive3.hcd: the import has to provide that name too.
+ */
+&wifi {
+	brcm,board-type = "samsung,gtactive3wifi";
+};
+
+/*
+ * hw_rev 5 speaker amplifier. Disabled until the TAS2562 is wired into the
+ * sound card (the upstream tas2562 codec driver exists; its supplies,
+ * shutdown GPIO and the A-Box UAIF are still to be confirmed against the
+ * stock tree), and the RT5510 that is not fitted here is switched off.
+ */
+&rt5510 {
+	status = "disabled";
+};
+
+&hsi2c_18 {
+	tas2562: amplifier@4c {
+		compatible = "ti,tas2562";
+		reg = <0x4c>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+};
+
+/*
+ * gtactive3_rt5665.c needs both DAI links, and the speaker link points at
+ * the RT5510: keep the card off for the first boots. Next: point the
+ * speaker link at &tas2562 (or make it optional in the machine driver).
+ */
+&{/sound} {
+	status = "disabled";
+};

+/*
+ * MAX77705 PMIC/charger/fuel gauge on HSI2C_40 (stock fragment@30,
+ * DTBO hw_rev 4). The controller node itself comes from the HSI2C work;
+ * until it transfers reliably the same devices can be reached through
+ * the i2c-gpio variant, exynos9810-gtactive3wifi-i2cgpio.dtb.
+ */
+&hsi2c_40 {
+	max77705: pmic@66 {
+		compatible = "maxim,max77705";
+		reg = <0x66>;
+		interrupts-extended = <&gpa1 6 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		pinctrl-0 = <&max77705_irq>;
+		pinctrl-names = "default";
+	};
+
+	max77705_charger: charger@69 {
+		compatible = "maxim,max77705-charger";
+		reg = <0x69>;
+		interrupt-parent = <&max77705>;
+		interrupts = <0>;
+		monitored-battery = <&battery>;
+		power-supplies = <&max77705_usbc>;
+
+		/* the OTG boost, VBUS of the USB host role */
+		max77705_otg_vbus: usb-otg-vbus {
+			regulator-name = "usb_otg_vbus";
+			regulator-min-microvolt = <5000000>;
+			regulator-max-microvolt = <5000000>;
+		};
+	};
+
+	/* USB-C block: BC1.2 / Type-C Rp source detection */
+	max77705_usbc: usb-c@25 {
+		compatible = "maxim,max77705-usbc";
+		reg = <0x25>;
+		interrupt-parent = <&max77705>;
+		interrupts = <3>;
+	};
+
+	/* fg_resistor = 2 in the stock DT, i.e. a 5 mOhm sense resistor */
+	fuel-gauge@36 {
+		compatible = "maxim,max77705-battery";
+		reg = <0x36>;
+		interrupt-parent = <&max77705>;
+		interrupts = <2>;
+		monitored-battery = <&battery>;
+		shunt-resistor-micro-ohms = <5000>;
+		power-supplies = <&max77705_charger>;
+	};
+
+	/*
+	 * Pogo-connector MUIC. Its IRQ handler in the stock kernel
+	 * (sm5504-muic-pogo.c) moves usb-mux-sel to the pogo pins when a
+	 * dock (ID 34k or 49.9k) is attached; mainline has no such consumer
+	 * yet, so the hog keeps USB on the USB-C port.
+	 */
+	muic@14 {
+		compatible = "siliconmitus,sm5504-muic";
+		reg = <0x14>;
+		interrupt-parent = <&gpa1>;
+		interrupts = <4 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-0 = <&sm5504_irq>;
+		pinctrl-names = "default";
+	};
+};
+
+/* Peripheral I2C clients (stock-0.dts / dtbo-4.dts, hw_rev 4) */
+&hsi2c_20 {
+	clock-frequency = <400000>;
+
+	/* S.LSI NFC controller (stock "sec-nfc", 400 kHz bus) */
+	nfc@27 {
+		compatible = "samsung,s3fwrn5-i2c";
+		reg = <0x27>;
+		interrupt-parent = <&gpa1>;
+		interrupts = <2 IRQ_TYPE_EDGE_RISING>;
+		/* VEN: high = power down; FIRM: high = firmware mode */
+		en-gpios = <&gpg1 0 GPIO_ACTIVE_HIGH>;
+		wake-gpios = <&gpg1 6 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&nfc_irq &nfc_pd &nfc_firm>;
+		pinctrl-names = "default";
+		pvdd-supply = <&s2mps18_ldo41>;
+		/*
+		 * Reference clock: TCXO on CLKOUT1 (stock "oscclk_nfc"). The
+		 * stock driver gates it by the chip's request line (gpa2-6),
+		 * here it runs while the driver is bound.
+		 */
+		clocks = <&pmu_system_controller 0>;
+		assigned-clocks = <&pmu_system_controller 0>;
+		assigned-clock-parents = <&oscclk>;
+	};
+};
+
+&hsi2c_23 {
+	clock-frequency = <400000>;
+
+	/*
+	 * Wacom W9019 EMR digitiser (stock "wacom,w90xx", fw
+	 * w9019_gtactive3.bin, max 17222 x 10764, pressure 4095,
+	 * wacom,invert = <0 1 1>: y inverted, then x/y swapped).
+	 * Bootloader address 0x09 is only used for firmware updates.
+	 */
+	digitizer@56 {
+		compatible = "wacom,w9019";
+		reg = <0x56>;
+		interrupt-parent = <&gpa3>;
+		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
+		vdd-supply = <&vdd_wacom>;
+		flash-mode-gpios = <&gpm41 0 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&epen_irq>;
+		pinctrl-names = "default";
+		touchscreen-inverted-y;
+		touchscreen-swapped-x-y;
+		/* 8.0" 16:10 panel; raw x is the long axis */
+		touchscreen-x-mm = <172>;
+		touchscreen-y-mm = <108>;
+	};
+};
+
+&hsi2c_34 {
+	/*
+	 * Stock runs it at 10 kHz, which the 200 MHz USI clock cannot be
+	 * divided down to ("FS clock set-up failed"); the A96T3x6 is fine
+	 * at 100 kHz.
+	 */
+	clock-frequency = <100000>;
+
+	/* ABOV A96T3x6 Wi-Fi antenna grip sensor */
+	proximity@20 {
+		compatible = "abov,a96t3x6";
+		reg = <0x20>;
+		interrupt-parent = <&gpa1>;
+		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
+		vdd-supply = <&s2mps18_ldo40>;
+		pinctrl-0 = <&grip_irq>;
+		pinctrl-names = "default";
+	};
+};

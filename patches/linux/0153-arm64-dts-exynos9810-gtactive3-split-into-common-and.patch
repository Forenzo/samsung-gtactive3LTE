+/*
+ * SPI20: Broadcom BCM4775 GNSS chip with its sensor-hub MCU (stock
+ * "ssp,BCM4773" node, DTBO hw_rev 4 fragments 92-95). On this board the
+ * accelerometer (ICM-42605M), light/proximity (TMD3725) and magnetometer
+ * (AK09916) hang off the hub, not off the AP. Pin settings as in the
+ * stock overlay: no pull on SCLK/MOSI/CS, pull-down on MISO, drive 3.
+ */
+&pinctrl_chub {
+	shub_spi_bus: shub-spi-bus-pins {
+		samsung,pins = "gph0-0", "gph0-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};

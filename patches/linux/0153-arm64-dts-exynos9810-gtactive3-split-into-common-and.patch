 	exynos9810-gtactive3wifi.dtb	\
 	exynos9810-gtactive3wifi-i2cgpio.dtb \
 	exynos9810-gtactive3wifi-grip.dtb \
diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3-common.dtsi b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3-common.dtsi

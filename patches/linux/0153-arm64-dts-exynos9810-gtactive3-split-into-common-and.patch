+		 * (stock resumes at a CAL "resume" level in the same range).
+		 */
+		opp-1053000000 {
+			opp-hz = /bits/ 64 <1053000000>;
+			clock-latency-ns = <100000>;
+			opp-microwatt = <80000>;
+			opp-suspend;
+		};
+
+		opp-1248000000 {
